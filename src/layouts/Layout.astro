---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Agencia de branding y diseño en Argentina | Zil Design",
  description = "Agencia de branding y diseño de identidad de marca en Argentina. Estrategia, sistema visual y cada punto de contacto, sostenidos por un equipo.",
} = Astro.props;

// La URL pública, que NO es la de este proyecto: Astro sirve bajo `base`, pero
// para el mundo la página vive en zil.global/design/ detrás del proxy de
// zil-landing. Canonical y og:url tienen que declarar esa, o Google indexa (o
// descarta) una dirección que nadie visita.
//
// Se arma por página, no fija. Cuando era una constante, las cuatro páginas de
// proyecto declaraban como canónica la home: le estábamos diciendo a Google que
// cada caso de estudio era una copia de la portada, que es la forma exacta de
// pedir que no los indexe. `Astro.url.pathname` ya incluye el `base`, y `site`
// (astro.config.mjs) aporta el host.
const PUBLIC_URL = new URL(Astro.url.pathname, Astro.site).href;
// El banner vive en el sitio principal. Es el mismo dominio, así que resuelve
// igual, y es preferible a compartir un link sin imagen.
const OG_IMAGE = "https://zil.global/zil-banner.webp";

// Vite rewrites url() inside CSS against `base`, but a literal href in markup is
// just a string it never touches — so /favicon would resolve against
// zil.global's root, where the Next app answers 404. Anything in public/ that is
// referenced from HTML has to carry this prefix explicitly.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The fonts live in src/assets, not public/, so Vite owns their URLs and emits
// them base-correct in BOTH dev and build. They used to sit in public/ and be
// referenced as `/fonts/...`, which Vite silently rewrote at build time but not
// in dev — so `astro dev` served the whole site in the fallback system font
// while production was fine. Importing with `?url` gives the same emitted URL
// the @font-face rules resolve to, so these preloads actually get used instead
// of fetching a second copy.
import bookWoff2 from "../assets/fonts/CircularStd-Book.woff2?url";
import boldWoff2 from "../assets/fonts/CircularStd-Bold.woff2?url";
---

<!doctype html>
<!-- lang="es": toda la página está escrita en castellano rioplatense ("¿Tenés
     alguna duda?"). Declararla en inglés le decía a Google que el contenido no
     era relevante para las búsquedas en español, que son las que buscamos. -->
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={PUBLIC_URL} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={PUBLIC_URL} />
    <meta property="og:site_name" content="Zil Design" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={OG_IMAGE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}/favicon.svg`}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}/favicon-darkmode.svg`}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {
      /* Meta Pixel — the SAME pixel as zil-landing (id 2107258050021163), because
        this site is a section of zil.global, not a separate property: one pixel
        means one audience and one attribution window across both.
        `scripts/lead-form.ts` fires the `Lead` event on submit.

        Split in two on purpose. zil-landing defers the WHOLE snippet behind
        requestIdleCallback, which also defers the `fbq` stub — anything tracked
        before that runs hits an undefined `fbq` and is lost. Here the stub is
        installed synchronously (it only queues calls, costing nothing) and only
        the network request for fbevents.js is deferred, so an early `Lead` is
        queued and flushed when the library lands. */
    }
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
      })(window, document, "script");
      fbq("init", "2107258050021163");
      fbq("track", "PageView");
      (function () {
        var load = function () {
          var t = document.createElement("script");
          t.async = !0;
          t.src = "https://connect.facebook.net/en_US/fbevents.js";
          document.head.appendChild(t);
        };
        if (typeof requestIdleCallback === "function")
          requestIdleCallback(load);
        else setTimeout(load, 3500);
      })();
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=2107258050021163&ev=PageView&noscript=1"
        alt=""
      /></noscript
    >
    {
      /* GA4 — the SAME property as zil-landing (G-BGMH92ZFKE), for the same reason
        as the pixel: this site is served from zil.global/design, so a second
        property would start a new session the moment a visitor crossed over and
        split the funnel across two reports. `/design` is a path filter, not a
        property. `scripts/lead-form.ts` fires `generate_lead` on submit.

        Same split as the pixel: `gtag` and its dataLayer are defined synchronously
        so an early event is queued rather than dropped, and only gtag/js is
        deferred to idle. This is also what the official snippet does — the inline
        half is never the expensive part. */
    }
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", "G-BGMH92ZFKE");
      (function () {
        var load = function () {
          var s = document.createElement("script");
          s.async = !0;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-BGMH92ZFKE";
          document.head.appendChild(s);
        };
        if (typeof requestIdleCallback === "function")
          requestIdleCallback(load);
        else setTimeout(load, 3500);
      })();
    </script>
    {
      /* MOTION POLICY, JS half — see the matching block at the top of global.css.
        Nine components ask matchMedia whether the reader wants reduced motion, and
        this site's answer is now always "no". Reporting it once here keeps every
        one of those guards written the standard way instead of deleting them.

        It MUST run before any module: the guards read the query at import time.
        Only this one query is overridden — every other media query passes through
        untouched. */
    }
    <script is:inline>
      (function () {
        var real = window.matchMedia.bind(window);
        var noop = function () {};
        window.matchMedia = function (q) {
          if (!/prefers-reduced-motion/.test(q)) return real(q);
          // A plain stand-in, not the real MediaQueryList: `matches` is a
          // prototype getter with no setter, so assigning to it silently fails.
          return {
            matches: false,
            media: q,
            onchange: null,
            addEventListener: noop,
            removeEventListener: noop,
            addListener: noop,
            removeListener: noop,
            dispatchEvent: function () {
              return false;
            },
          };
        };
      })();
    </script>
    {
      /* Arms the scroll entrances. This is the ONE place that decides whether any
        element is allowed to start hidden; global.css hides only from
        `html.reveal-armed`, and scripts/reveal.ts animates only if this class is
        present, so the decision cannot be made twice and drift.

        It must stay INLINE and in <head>. Inline is what puts the decision before
        first paint: a deferred module would let the page render, then yank content
        away to animate it in.

        Three readers get the finished page precisely because they never reach
        `add()`:
          · no JS at all, and crawlers that don't run it — the class never lands.
          · prefers-reduced-motion — nothing hides, so nothing needs revealing.
          · a document that is HIDDEN at load: a tab opened in the background, a
            headless renderer. GSAP's ticker is requestAnimationFrame-driven, so
            in a hidden document tweens never advance — arming there would hide
            every element behind an animation that cannot run and leave the page
            blank. HeroFloaters guards the same trap for the same reason; the
            trade is that a background-opened tab shows a composed page with no
            entrance, which is the right way to fail. */
    }
    <script is:inline>
      if (
        document.visibilityState === "visible" &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("reveal-armed");
      }
    </script>
    {/* Preload the two most-used weights to avoid a flash of fallback text. */}
    <link
      rel="preload"
      href={bookWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={boldWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>

    {
      /* Le dice a Google QUÉ es esto: una agencia, no una página cualquiera que
        menciona branding. Sin dirección postal no califica para resultados
        locales —no perseguimos eso—; sirve para que la entidad "Zil Design"
        quede ligada a Zil Global y al servicio que presta. */
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "@id": `${PUBLIC_URL}#organization`,
        name: "Zil Design",
        url: PUBLIC_URL,
        image: OG_IMAGE,
        description,
        areaServed: { "@type": "Country", name: "Argentina" },
        parentOrganization: {
          "@type": "Organization",
          name: "Zil Global",
          url: "https://zil.global",
        },
        serviceType: [
          "Branding",
          "Diseño de identidad de marca",
          "Diseño estratégico",
        ],
      })}
    />
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/smooth-scroll";
    </script>

    {
      /* Scroll entrances for the whole site. Declarative: sections opt in with
        `data-reveal` attributes and this engine drives them. See scripts/reveal.ts. */
    }
    <script>
      import "../scripts/reveal";
    </script>

    {
      /* Contact forms. Both placements (sections/CTA.astro and ContactDrawer)
        declare `data-lead-*` markup and this engine posts the lead to workspace
        and hands the reader off to the booking calendar. See scripts/lead-form.ts. */
    }
    <script>
      import "../scripts/lead-form";
    </script>

    {
      /* Firefox half of the no-drag-ghost rule. `-webkit-user-drag: none` in
        global.css handles Chrome and Safari but does not exist in Firefox, so the
        gesture is cancelled here instead. Delegated from the document, so it also
        covers images that arrive later (hydrated islands, carousels). */
    }
    <script is:inline>
      document.addEventListener("dragstart", (e) => {
        const t = e.target;
        if (t instanceof Element && t.closest("img, svg")) e.preventDefault();
      });
    </script>

    <script>
      /**
       * Smooth in-page anchor scrolling.
       *
       * This lives here rather than as `html { scroll-behavior: smooth }` in
       * global.css on purpose. GSAP ScrollTrigger writes an inline
       * `scroll-behavior: auto` on the scroller and relies on it: every
       * `refresh()` jumps the page to 0 to measure natural offsets and jumps
       * back, and both hops have to be instant. A CSS rule would need
       * `!important` to beat that inline style, which animates the jump to 0 —
       * a visible flight to the top, and on iOS Safari the restore can be
       * cancelled by touch/momentum, stranding the reader there.
       *
       * Passing `behavior` explicitly overrides the computed `auto` for this one
       * call, so anchors smooth-scroll and GSAP keeps its instant writes.
       */
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      document.addEventListener("click", (event) => {
        // The mobile menu closes itself first and then runs its own scroll.
        if (event.defaultPrevented) return;
        const el = event.target as HTMLElement | null;
        const link = el?.closest<HTMLAnchorElement>('a[href^="#"]');
        const hash = link?.getAttribute("href");
        if (!hash || hash.length < 2) return;
        const dest = document.querySelector(hash);
        if (!dest) return;

        event.preventDefault();

        // When Lenis is driving the scroll it owns the scroll position on its own
        // rAF loop; a native `scrollIntoView` races that loop and the jump
        // intermittently stalls (the "click twice to go up" bug). So route through
        // lenis.scrollTo when it exists.
        //
        // Lenis already honours the target's `scroll-margin-top` — the
        // `.scroll-anchor` knob in global.css, which is where landing position
        // is decided. Do NOT also pass it as an explicit offset: that
        // double-counts the inset and drops every section too low. (An earlier
        // Lenis version ignored the insets, which the removed manual offset
        // compensated for.)
        const lenis = window.lenis;
        if (lenis) {
          lenis.scrollTo(dest as HTMLElement);
        } else {
          // No Lenis (reduced motion): native scroll honours the CSS offsets.
          dest.scrollIntoView({
            behavior: reduceMotion.matches ? "auto" : "smooth",
            block: "start",
          });
        }
        history.pushState(null, "", hash);
      });
    </script>
  </body>
</html>
