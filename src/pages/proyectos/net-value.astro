---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/astro/Header.astro";
import Footer from "../../components/astro/Footer.astro";
import ProjectHeroImage from "../../components/astro/project/ProjectHeroImage.astro";
import ProjectBrief from "../../components/astro/project/ProjectBrief.astro";
import ConceptCircles from "../../components/astro/project/ConceptCircles.astro";
import ColorPalette from "../../components/astro/project/ColorPalette.astro";
import LogoGrid from "../../components/astro/project/LogoGrid.astro";
import TypeSpecimen from "../../components/astro/project/TypeSpecimen.astro";
import CoverCollage from "../../components/astro/project/CoverCollage.astro";
import Mosaic from "../../components/astro/project/Mosaic.astro";
import MockupAside from "../../components/astro/project/MockupAside.astro";
import ProjectEnd from "../../components/astro/project/ProjectEnd.astro";
import BackToTop from "../../components/astro/project/BackToTop.astro";
import heroImage from "../../assets/net-value/net-hero.avif";
import heroImageMobile from "../../assets/net-value/net-hero-mobile.avif";
import gridImage from "../../assets/net-value/net-grid.svg";
import netFontImg from "../../assets/net-value/net-font.svg";
import netLogo from "../../assets/net-value/net-logo.svg";
import netLogoFilled from "../../assets/net-value/net-logo-filled.svg";
import netLogoWithBox from "../../assets/net-value/net-logo-with-box.svg";
import netLogoWithBoxFilled from "../../assets/net-value/net-logo-with-box-filled.svg";
import collage1 from "../../assets/net-value/collage-1.avif";
import collage2 from "../../assets/net-value/collage-2.avif";
import postsImg from "../../assets/net-value/posts.avif";
import spotifyImg from "../../assets/net-value/spotify.avif";
import thumbnailsImg from "../../assets/net-value/thumbnails.avif";
import liveImg from "../../assets/net-value/live.avif";
// Onest is Net Value's brand face. Self-hosted (Google Fonts' `latin` subset,
// which covers Spanish in full) rather than loaded from fonts.gstatic.com, so the
// page keeps its own asset graph and costs no third-party connection. ONE file:
// Google ships Onest as a variable font, so Regular and Bold are the same
// download driven along the wght axis — registering two static faces would just
// fetch the same bytes twice.
import onestVariable from "../../assets/net-value/onest/Onest-Variable.woff2?url";

// @font-face can't read CSS vars for its src, so the resolved URL is interpolated
// and injected globally (same approach as the Gelato and Quantia pages).
const fontFaceCss = `
@font-face{font-family:"Onest";src:url("${onestVariable}") format("woff2");font-weight:100 900;font-style:normal;font-display:swap;}
`;

// Case-study content lives with the page (per-project composition).
const meta = [
  { label: "Cliente", value: "Net Value" },
  { label: "Servicio", value: "Branding" },
];

const brief = [
  {
    title: "Proyecto",
    body: "<strong>Net Value es un podcast de negocios que entrevista a empresarios y emprendedores.</strong> En cada episodio, los invitados cuentan cómo construyeron sus empresas, qué decisiones marcaron el camino y qué aprendieron en el proceso, con consejos aplicables para quien está empezando o haciendo crecer su propio proyecto.",
  },
  {
    title: "Desafío",
    body: "El podcast nacía sin identidad y en una categoría saturada. El reto era <strong>construir una marca desde cero que transmitiera solidez y credibilidad sin caer en la solemnidad corporativa</strong>, y que funcionara en entornos digitales exigentes: portadas, miniaturas, clips verticales y redes.",
  },
  {
    title: "Propuesta",
    body: "Desde Zil Design creamos la identidad completa de Net Value: logotipo, paleta cromática, sistema tipográfico y manual de marca. <strong>Diseñamos un sistema modular que resiste la reducción y se adapta a cada formato</strong>, dándole al podcast una imagen consistente y profesional desde su lanzamiento.",
  },
];

const concepts = [
  "Inspiración",
  "Autoridad",
  "Cercanía",
  "Impulso",
  "Experiencia",
];

// Brand palette — single full-bleed swatches (no tint pairs). RGB is derived from
// the hex in the component, so a label can never drift from its swatch. NOTE: the
// source mock's RGB is still wrong on two rows — Gris Net reads R75/G37/B10 and
// Blanco R225/G225/B225, neither of which matches its hex. Hex is treated as
// source of truth, so the component renders the correct values.
// `dark` marks the fields deep enough to carry white text.
const palette = [
  { name: "Violeta Net", main: { hex: "#7510D3", dark: true }, weight: 1.9 },
  {
    name: "Violeta Oscuro Net",
    main: { hex: "#5F03B4", dark: true },
    weight: 1.85,
  },
  { name: "Negro", main: { hex: "#000000", dark: true }, weight: 1 },
  { name: "Blanco", main: { hex: "#FFFFFF" }, weight: 0.85 },
  { name: "Gris Net", main: { hex: "#8A9299", dark: true }, weight: 0.75 },
];
---

<style is:global set:html={fontFaceCss}></style>

<Layout
  title="Net Value — Zil Design"
  description="Caso de estudio: identidad de marca para Net Value — solidez sin solemnidad."
>
  <Header />
  <main class="project-net-value">
    <ProjectHeroImage
      image={heroImage}
      mobileImage={heroImageMobile}
      imageAlt="Los fundadores de Net Value, sonriendo sobre un fondo negro, con el isotipo de la marca entre ambos"
      title="Net Value"
    />
    <ProjectBrief meta={meta} blocks={brief} />
    {
      /* `stroke` and `gridWidth` both point at the grid artwork on purpose: the
        rings are drawn in the colour it strokes its rules in (#7510D3) and at the
        weight derived from its intrinsic width, so the two sections render the
        literal same hairline. */
    }
    <ConceptCircles
      words={concepts}
      gridWidth={gridImage.width}
      stroke="#7510D3"
      fontFamily={'"Onest", sans-serif'}
    />
    <LogoGrid
      image={gridImage}
      alt="Isotipo de Net Value dentro de su grilla de composición"
    />
    <ColorPalette colors={palette} />
    {
      /* `specimens` (rather than regularUrl/boldUrl) because this page already
        registers Onest for the concept rings — the default path would emit a
        second @font-face for the same family, and hard-code format("opentype")
        against a file that is woff2. Both rows come off the one variable file,
        driven along its wght axis. */
    }
    <TypeSpecimen
      name="Onest"
      fontFamily="Onest"
      wordmarkImage={netFontImg}
      specimens={[
        {
          label: "Onest - Regular",
          fontFamily: '"Onest", sans-serif',
          fontWeight: 400,
        },
        {
          label: "Onest - Bold",
          fontFamily: '"Onest", sans-serif',
          fontWeight: 700,
        },
      ]}
    />
    {
      /* Two rows, each pairing a cover with a mark panel on the opposite side, so
        the isotipo is read against both of its extreme fields — black and violet.

        The BLACK panel omits `ink`: the boxed cuts are two-tone (a violet tile
        with a white counter, and its inverse), and masking would flatten both to
        one silhouette. The VIOLET panel sets it, because the bare cuts are filled
        in exactly the violet they sit on and would otherwise vanish.

        The panel ratios are the composition's, not an asset's: 1.75 leaves the
        square cover a third of the top row, and 1.7 splits the bottom row almost
        evenly against the 16:9 cover. */
    }
    <CoverCollage
      ariaLabel="Portadas de episodios y aplicaciones del isotipo"
      rows={[
        [
          {
            kind: "image",
            stackOrder: 1,
            src: collage1,
            alt: "Portada del episodio 21, «Vendimos y me arrepentí», con una invitada durante la grabación",
          },
          {
            kind: "card",
            stackOrder: 2,
            bg: "#000000",
            ratio: 1.75,
            marks: [netLogoWithBoxFilled, netLogoWithBox],
            label:
              "El isotipo de Net Value encapsulado, en sus dos versiones: violeta con la marca en blanco y blanco con la marca en violeta",
          },
        ],
        [
          {
            kind: "card",
            stackOrder: 4,
            bg: "#7510D3",
            ratio: 1.7,
            ink: "#FFFFFF",
            marks: [netLogo, netLogoFilled],
            label:
              "El isotipo de Net Value en blanco sobre violeta, en sus versiones sólida y de contorno",
          },
          {
            kind: "image",
            stackOrder: 3,
            src: collage2,
            alt: "Miniatura de Señal de Mercado EP 15, «Empezamos con cero pesos», con los conductores en el set",
          },
        ],
      ]}
    />
    {
      /* From here down the case study inverts to the black field — see the note
        on `.net-dark` in the styles. The wrapper carries colour and NOTHING else:
        no padding, no margin, so the section rhythm is still the sum of the two
        halves its neighbours own. */
    }
    <div class="net-dark">
    {
      /* One piece, so the bento degenerates to a single cell — what earns Mosaic
        here is `fit="natural"`: the mockup is a composed shot whose margin around
        the phones IS the piece, and any crop would read as zoomed in. `inset`
        puts it on the content edge rather than the mosaic's own full-bleed gap,
        so it lines up with the collage above it. */
    }
    <Mosaic
      topBorder
      imageBorder={false}
      fit="natural"
      inset="var(--gutter)"
      ariaLabel="El sistema aplicado a publicaciones de redes sociales"
      rows={[
        {
          items: [
            {
              src: postsImg,
              alt: "Tres publicaciones de Instagram de Net Value: «Pensar a largo plazo», «Escalar con poco» y «La trampa del crecimiento»",
            },
          ],
        },
      ]}
    />
    <MockupAside
      label="El sistema en el reproductor"
      body="La portada es lo único que se ve antes de darle play. Cada episodio se arma sobre la retícula del isotipo: el sistema absorbe títulos de cualquier largo y la marca se reconoce a tamaño de miniatura."
      image={spotifyImg}
      imageAlt="Tres pantallas de la aplicación mostrando episodios de Net Value en reproducción, con sus portadas en negro y violeta"
      ariaLabel="El sistema aplicado a las portadas dentro del reproductor"
    />
    {
      /* `reverse` on the first of the pair, so the three mockup sections
        alternate down the page instead of stacking every piece of art along the
        same edge. */
    }
    <MockupAside
      reverse
      label="Miniaturas para YouTube"
      body="Diseñamos un sistema de miniaturas consistente y memorable, fiel a la identidad de la marca. Cada episodio nuevo se arma sobre la misma plantilla, de forma tal que el canal crece sin perder unidad."
      image={thumbnailsImg}
      imageAlt="La página de un episodio de Net Value en YouTube, con la miniatura violeta y la lista de episodios sugeridos"
      ariaLabel="Miniaturas de los episodios en YouTube"
    />
    <MockupAside
      label="La marca dentro del video"
      body="Cualquier frame del episodio tiene que poder salir solo. El isotipo queda fijo en una esquina y los títulos entran sobre placas con la tipografía del sistema, así que una captura, un clip o una recomendación arrastran la marca sin depender del canal que los muestre."
      image={liveImg}
      imageAlt="Un episodio de Net Value reproduciéndose, con la placa de título «Emprender en Argentina» y el isotipo fijo en la esquina"
      ariaLabel="La gráfica de marca dentro del video"
    />
    </div>
    <BackToTop />
  </main>
  <ProjectEnd current="net-value" />
  <Footer />
</Layout>

<style>
  /* Scoped project theme — remaps ONLY the semantic colour aliases within this
     page's subtree, so Net Value's branding can never leak into global scope.
     Everything structural (type scale, spacing rhythm, breakpoints) stays on the
     global tokens.

     Straight from the brand palette below. The body is a WHITE field — the black
     of the key art stays in the hero, so the photography and the palette bands
     are the dark moments and the case study itself reads as paper. Violeta Net
     (#7510D3) is then the one saturated voice on that paper: the concept rings,
     the logo grid, the accent discs — and it draws the section rules too, so
     every boundary on the page is stated in the brand's own colour rather than
     in a neutral hairline. */
  .project-net-value {
    --color-primary: #7510d3; /* Violeta Net (brand palette) */
    --color-accent: #7510d3;

    --color-surface: #ffffff; /* Blanco — white case-study field */
    --color-text: #000000; /* Negro — body text */
    --color-muted: #8a9299; /* Gris Net — secondary copy */
    --color-border: #7510d3; /* Violeta Net — section rules carry the brand */

    background-color: var(--color-surface);
    color: var(--color-text);
  }

  /* The applications half of the case study, inverted onto the black field.
     The brand lives on both grounds and the page argues that by switching under
     the reader: the identity is built on paper above, and applied on screen
     below, where every piece it is applied TO is a dark interface.

     It REDECLARES the same aliases the parent set, so the sections inside need
     no knowledge of it — `text-text`, `text-muted` and `border-border` all keep
     resolving through the cascade and simply come out inverted. Only the two
     values that actually flip are listed; `--color-primary` / `--color-accent`
     and `--color-muted` carry over from the parent unchanged, which is the
     point: Violeta Net and Gris Net are legible on either ground.

     The four mockups it holds are cut out on TRANSPARENCY, which is what makes
     this safe — on a white-backed shot the same swap would frame each piece in a
     bright rectangle. Check the alpha before adding a fifth. */
  .net-dark {
    --color-surface: #000000; /* Negro — the applications field */
    --color-text: #ffffff; /* Blanco — body text on black */

    background-color: var(--color-surface);
    color: var(--color-text);
  }
</style>
