import mcPostMasterclass from "../../assets/quantia/mc-post-masterclass.webp";
import mcPostFinanzas from "../../assets/quantia/mc-post-finanzas.webp";
import mcMockupInvertir from "../../assets/quantia/mc-mockup-invertir.webp";
import mcHistoriaComenzar from "../../assets/quantia/mc-historia-comenzar.webp";
import mcHistoriaPortafolio from "../../assets/quantia/mc-historia-portafolio.webp";
import mcHistoriaCadaPaso from "../../assets/quantia/mc-historia-cada-paso.webp";
import mcIconoMeta from "../../assets/quantia/mc-icono-meta.webp";
import mcIconoDolar from "../../assets/quantia/mc-icono-dolar.webp";
import mcIconoBanco from "../../assets/quantia/mc-icono-banco.webp";
import mcIconoCalendario from "../../assets/quantia/mc-icono-calendario.webp";
import mcIconoDistribuir from "../../assets/quantia/mc-icono-distribuir.webp";
import mcIconoLupa from "../../assets/quantia/mc-icono-lupa.webp";
import mcIconoEscalera from "../../assets/quantia/mc-icono-escalera.webp";
import mcIconoDiversificar from "../../assets/quantia/mc-icono-diversificar.webp";
import mcIconoOpciones from "../../assets/quantia/mc-icono-opciones.webp";
import mcIconoRiesgo from "../../assets/quantia/mc-icono-riesgo.webp";
import mcIconoUbicacion from "../../assets/quantia/mc-icono-ubicacion.webp";
import mcIconoFicha from "../../assets/quantia/mc-icono-ficha.webp";
import mcIconoCronometro from "../../assets/quantia/mc-icono-cronometro.webp";
import mcIconoFlecha from "../../assets/quantia/mc-icono-flecha.webp";
// Ubuntu is Quantia's brand face, self-hosted (Google Fonts' `latin` subset,
// which covers Spanish in full) rather than loaded from fonts.gstatic.com, so
// the page keeps its own asset graph and costs no third-party connection.
import ubuntuRegular from "../../assets/quantia/ubuntu/Ubuntu-Regular.woff2?url";
import ubuntuMedium from "../../assets/quantia/ubuntu/Ubuntu-Medium.woff2?url";
import ubuntuBold from "../../assets/quantia/ubuntu/Ubuntu-Bold.woff2?url";

// @font-face can't read CSS vars for its src, so the resolved URLs are
// interpolated and injected globally (same approach as the Gelato page).
const fontFaceCss = `
@font-face{font-family:"Ubuntu";src:url("${ubuntuRegular}") format("woff2");font-weight:400;font-style:normal;font-display:swap;}
@font-face{font-family:"Ubuntu";src:url("${ubuntuMedium}") format("woff2");font-weight:500;font-style:normal;font-display:swap;}
@font-face{font-family:"Ubuntu";src:url("${ubuntuBold}") format("woff2");font-weight:700;font-style:normal;font-display:swap;}
`;

// Case-study content lives with the page (per-project composition).
const meta = [
  { label: "Cliente", value: "Quantia" },
  { label: "Servicio", value: "Social Media" },
];

const brief = [
  {
    title: "Proyecto",
    body: "Quantia Hub es una plataforma financiera panameña que facilita el acceso al ahorro, las inversiones y la planificación financiera. Con el respaldo de más de 25 años de experiencia, combina educación financiera y herramientas digitales para ayudar a las personas a construir un futuro económico más sólido de forma simple, segura y accesible.",
  },
  {
    title: "Desafío",
    body: "Quantia Hub necesitaba una estrategia de contenidos para redes sociales que impulsara el conocimiento de la plataforma y reforzara su presencia digital. El reto era comunicar conceptos financieros de manera simple y mantener una identidad visual consistente en cada formato y canal.",
  },
  {
    title: "Propuesta",
    body: "Desde Zil Design desarrollamos un sistema de contenidos para redes sociales compuesto por posteos, historias y carruseles informativos. La propuesta permitió comunicar las funcionalidades y el valor de Quantia Hub de forma clara, consistente y adaptable a los distintos formatos de Instagram.",
  },
];

const concepts = ["Educar", "Crecer", "Apoyar", "Cuidar", "Acompañar"];

// Brand palette — single full-bleed swatches. RGB is derived from the hex in the
// component, so a label can never drift from its swatch. NOTE: the source board
// lists Verde claro as R237/G237/B237, which is #EDEDED, not #90D5AC — a stray
// value from another palette. Hex is treated as source of truth, so the
// component renders the correct R144/G213/B172. `dark` marks the three fields
// deep enough to carry white text.
const palette = [
  { name: "Verde", main: { hex: "#00AC69", dark: true }, weight: 1.55 },
  { name: "Verde oscuro", main: { hex: "#124734", dark: true }, weight: 1.4 },
  { name: "Violeta", main: { hex: "#644B92", dark: true }, weight: 1.4 },
  { name: "Violeta claro", main: { hex: "#BEA8DD" }, weight: 1.05 },
  { name: "Verde claro", main: { hex: "#90D5AC" }, weight: 1.2 },
  { name: "Amarillo", main: { hex: "#DAE343" }, weight: 1.1 },
  { name: "Gris", main: { hex: "#D5D1C6" }, weight: 1 },
];
---

<style is:global set:html={fontFaceCss}></style>

<Layout
  title="Quantia — Zil Design"
  description="Caso de estudio: producto digital y comunicación para Quantia — decisiones financieras con dirección clara."
>
  <Header />
  <main class="project-quantia">
    {
      /* One photograph at every size: it is a landscape shot built around a
        vertical subject (the hand and the phone in the pocket), so the portrait
        crop lands on that subject on its own and needs no second artwork.

        THE CUT. Landscape, the field is the wedge BELOW a line from 13.7% of
        the height at the left edge to 46% of the width at the foot, and the
        lockup stands in its wide end. The phone sits right of centre, so the
        wedge takes the corner the composition had already given away.

        Portrait, that same wedge would have to cross the phone to be big
        enough to hold the lockup, so it lies down instead: a slope across the
        FOOT, from 68% of the height at the left to 80% at the right. The
        photograph keeps the whole upper frame — the hand, the pocket, the
        screen — and the lockup still stands on the brand's own green. */
    }
    <DiagonalHero
      image={heroImage}
      imageAlt="Una persona guarda el teléfono en el bolsillo del pantalón con la app de Quantia Hub en pantalla"
      imagePosition="center"
      imagePositionMobile="58% center"
      field="#00AC69"
      logo={heroLogo}
      title="Quantia — producto digital"
      cut="polygon(0 13.7%, 46% 100%, 0 100%)"
      cutMobile="polygon(0 68%, 100% 80%, 100% 100%, 0 100%)"
      lockup={{ top: "79.2%", left: "5.4%", width: "19.1%" }}
      lockupMobile={{ top: "83%", left: "6%", width: "46%" }}
    />
    <ProjectBrief meta={meta} blocks={brief} />
    <ConceptCircles
      words={concepts}
      gridWidth={gridImage.width}
      stroke="#124734"
      ink="#124734"
      fontFamily={'"Ubuntu", sans-serif'}
      fontWeight={400}
    />
    <LogoGrid
      image={gridImage}
      alt="Logotipo de Quantia dentro de su grilla de composición"
    />
    <ColorPalette colors={palette} />
    {
      /* `specimens` (rather than regularUrl/boldUrl) because this page already
        registers Ubuntu for the concept rings — the default path would emit a
        second @font-face for the same family, and hard-code format("opentype")
        against files that are woff2. */
    }
    <TypeSpecimen
      name="Ubuntu"
      fontFamily="Ubuntu"
      wordmarkImage={quantiaFontImg}
      specimens={[
        {
          label: "Ubuntu - Regular",
          fontFamily: '"Ubuntu", sans-serif',
          fontWeight: 400,
        },
        {
          label: "Ubuntu - Bold",
          fontFamily: '"Ubuntu", sans-serif',
          fontWeight: 700,
        },
      ]}
    />
    {
      /* Unlike the old collage, both left tiles carry their OWN ground — a
        green gradient CSS would only approximate — so no fill colour is
        passed. The building tile is still the one that breaks its box: its
        artwork is 1.479 tiles tall against a ground of 1.498:1, and that
        difference is the overhang. */
    }
    <CampaignCollage
      panel={{
        src: edificioImg,
        alt: "La torre de la sede de Quantia recortada sobre un campo degradado verde",
      }}
      graphic={{
        src: tuDineroImg,
        alt: "Pieza de campaña: tu dinero merece más que improvisar",
      }}
      photo={{
        src: chicaImg,
        alt: "Una joven muestra la app de Quantia Hub en su teléfono",
      }}
      panelRatio={3329 / 2222}
      graphicRatio={3329 / 1911}
      photoRatio={3341 / 4183}
      columns="485fr 490fr"
    />
    {
      /* The pieces arrive FINISHED — the post cards carry their own Instagram
        chrome and the phones their own device frames — so this section places
        them and draws nothing. The first row's spans are the artboard's own
        widths (164 / 164 / 178): the phone is the widest, stands taller than
        the cards, and bottom-alignment is what puts the three on one line. */
    }
    <MockupShowcase
      label="Redes Sociales"
      body="Desarrollamos un sistema de contenido para redes sociales orientado a comunicar con claridad, fortalecer la identidad de la marca y mantener una presencia consistente. Cada pieza fue diseñada para captar la atención, transmitir el mensaje de forma inmediata y generar una comunicación más efectiva."
      rows={[
        [
          {
            src: postCuenta,
            alt: "Publicación: abre tu cuenta corriente en minutos y recibe 4% de interés anual",
            span: 164,
          },
          {
            src: postAccedes,
            alt: "Publicación: tu cuenta es solo el comienzo — alcancías, inversiones y fondo de retiro",
            span: 164,
          },
          {
            src: mockupTodoEnUno,
            alt: "La publicación «todo en un solo lugar» vista en el feed de Instagram",
            span: 178,
          },
        ],
        [
          {
            src: historiaPanama,
            alt: "Historia: hoy Panamá sale a la cancha, desde Quantia Hub acompañamos a nuestra selección",
          },
          {
            src: historiaComparte,
            alt: "Historia: compárteles la app y acércales una herramienta para dar el primer paso",
          },
          {
            src: historiaCalculadora,
            alt: "Historia: la calculadora de interés compuesto",
          },
        ],
      ]}
      {/* The strip, row by row as the board sets it: eight, then seven. */}
      iconRows={[
        [
          { src: iconoMundo, alt: "" },
          { src: iconoBolsa, alt: "" },
          { src: iconoChancho, alt: "" },
          { src: iconoCalendario, alt: "" },
          { src: iconoReloj, alt: "" },
          { src: iconoTienda, alt: "" },
          { src: iconoRelojArena, alt: "" },
          { src: iconoDestellos, alt: "" },
        ],
        [
          { src: iconoLibro, alt: "" },
          { src: iconoRiesgo, alt: "" },
          { src: iconoLupa, alt: "" },
          { src: iconoMeta, alt: "" },
          { src: iconoMoneda, alt: "" },
          { src: iconoPlan, alt: "" },
          { src: iconoDolar, alt: "" },
        ],
      ]}
    />
    {
      /* The pair arrives as ONE piece — the two phones were composed with
        their overlap and their shadows together, and splitting them would mean
        rebuilding that overlap in CSS for no gain. It is set off the column's
        left edge (`lead`), and the copy reads as a caption to it, so the
        heading takes a column beside the row rather than opening above it. */
    }
    <MockupShowcase
      label="Piezas para pauta"
      body="Desarrollamos piezas para campañas de pauta digital en formato de posteos estáticos e historias. Cada propuesta fue diseñada para captar la atención, transmitir mensajes de manera clara y reforzar la identidad de Quantia Hub en sus anuncios."
      headingBeside
      headingSpan={167}
      trailing={63.5}
      rows={[
        [
          {
            src: pautaPar,
            alt: "Dos publicaciones de pauta vistas en el feed: construye tu bienestar financiero y da el primer paso hacia tu inversión",
            span: 325,
            lead: 63.5,
          },
        ],
        [
          {
            src: pautaSabias,
            alt: "Historia: ¿sabías que existe una app para ahorrar, invertir y planificar tu futuro sin complicaciones?",
          },
          {
            src: pautaOrganiza,
            alt: "Historia: organiza tus ahorros con Quantia Hub — Alcancía Meta y Alcancía Libre",
          },
          {
            src: pautaDescarga,
            alt: "Historia: ahorra, invierte y planifica tu futuro desde una sola app",
          },
        ],
      ]}
    />
    <PhotoMosaic
      wideTop={{
        src: mosaicoColina,
        alt: "Una joven de camisa lila mira su teléfono sobre una colina",
      }}
      narrow={{
        src: mosaicoCielo,
        alt: "Una joven con el teléfono en la mano contra el cielo",
      }}
      pair={{
        src: mosaicoTerraza,
        alt: "Dos mujeres conversan en la mesa de una terraza",
      }}
      wideFoot={{
        src: mosaicoPasto,
        alt: "Una joven muestra la app de Quantia Hub al aire libre",
      }}
      tall={{
        src: mosaicoMuro,
        alt: "Una joven de camisa verde muestra la app sobre un muro claro",
      }}
      footLeft={{
        src: mosaicoEscalera,
        alt: "Dos amigas sentadas en unas escaleras con sus teléfonos",
      }}
      footRight={{
        src: mosaicoCeleste,
        alt: "Una mujer de vestido celeste sostiene su teléfono",
      }}
      corner={{
        src: mosaicoJardin,
        alt: "Una mujer de blazer muestra la app en un jardín",
      }}
      column={{
        src: mosaicoBolso,
        alt: "Un joven de suéter lila con el teléfono asomando del bolso",
      }}
    />
    {
      /* The only section on a field of its own: the artboard's wash, shipped
        as artwork because it is a mesh gradient and not a ramp CSS could
        restate.

        The heading takes the row's FIRST column here — the phone is tilted
        into the frame from the right, and the copy reads into it. */
    }
    <MockupShowcase
      label="Masterclass"
      body="Diseño de identidad para la promoción de las Masterclasses realizadas por Quantia Hub. Tomamos esta identidad y la desarrollamos pieza por pieza en todos sus formatos, incluyendo estáticos, carruseles e historias, y un template personalizado para la edición de videos verticales para cada una de ellas. Además, se realizó un sistema de símbolos personalizado para este contenido."
      headingBeside
      headingSide="start"
      headingSpan={133}
      trailing={85}
      fieldImage={mcFondo}
      rows={[
        [
          {
            src: mcPar,
            alt: "La pieza «3 Masterclasses» vista en el feed de Instagram",
            span: 131,
            tail: 85,
          },
        ],
        [
          {
            src: mcPostMasterclass,
            alt: "Publicación: Masterclass 1, el primer paso antes de invertir",
            span: 135,
          },
          {
            src: mcPostFinanzas,
            alt: "Publicación: conoce cómo están hoy tus finanzas",
            span: 136,
          },
          {
            src: mcMockupInvertir,
            alt: "La publicación «invertir bien empieza con preparación» vista en el feed",
            span: 149,
          },
        ],
        [
          {
            src: mcHistoriaComenzar,
            alt: "Historia: ¿quieres comenzar a invertir y entender mejor cuál puede ser tu primer paso?",
          },
          {
            src: mcHistoriaPortafolio,
            alt: "Historia: cada portafolio puede construirse según tus metas, tu plazo y tu perfil",
          },
          {
            src: mcHistoriaCadaPaso,
            alt: "Historia: cada paso suma en la construcción de tu bienestar financiero",
          },
        ],
      ]}
      {/* Siete y siete, en el orden del board. */}
      iconRows={[
        [
          { src: mcIconoMeta, alt: "" },
          { src: mcIconoDolar, alt: "" },
          { src: mcIconoBanco, alt: "" },
          { src: mcIconoCalendario, alt: "" },
          { src: mcIconoDistribuir, alt: "" },
          { src: mcIconoLupa, alt: "" },
          { src: mcIconoEscalera, alt: "" },
        ],
        [
          { src: mcIconoDiversificar, alt: "" },
          { src: mcIconoOpciones, alt: "" },
          { src: mcIconoRiesgo, alt: "" },
          { src: mcIconoUbicacion, alt: "" },
          { src: mcIconoFicha, alt: "" },
          { src: mcIconoCronometro, alt: "" },
          { src: mcIconoFlecha, alt: "" },
        ],
      ]}
    />
    {
      /* Another composed pair, and the last row of the case: the two phones
        were drawn tilted into each other, so the stagger between them is the
        artwork's and not a second piece to place. The copy sits beside it, as
        it does in the pauta row. */
    }
    <MockupShowcase
      label="Contenido para fecha patria"
      body="Desarrollamos piezas para campañas de pauta digital en formato de posteos estáticos e historias. Cada propuesta fue diseñada para captar la atención, transmitir mensajes de manera clara y reforzar la identidad de Quantia Hub en sus anuncios."
      headingBeside
      headingSpan={231}
      trailing={50.5}
      rows={[
        [
          {
            src: patrioPar,
            alt: "Dos piezas de fecha patria vistas en el feed: «un año de Quantia echando raíces» y «¿sabías que…?» sobre el balboa",
            span: 511,
            lead: 50.5,
          },
        ],
      ]}
    />
    {
      /* Halloween. The field is the piece: the board's own linear ramp, from
        nothing to the deep violet and back to nothing, so the section fades
        into the white ones either side instead of starting at a seam. The
        fade's length is a share of the WIDTH, not of the section: a section's
        height is whatever its rows add up to, so a percentage ramp would be
        gentler on a long section than on a short one and the copy would land
        somewhere different on each. Its stops are the board's own — white to
        violet and back, nothing in between — but interpolated in OKLAB: mixed
        in sRGB the ramp dives into the dark early and then crawls, and that
        uneven middle is what reads as a knee however long the ramp is. The heading is white here, and white on a half-faded violet is the one place
        this field could fail to be read. */
    }
