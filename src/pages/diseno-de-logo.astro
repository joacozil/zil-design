---
/**
 * Diseño de logo — 4.610 búsquedas/mes ganables, el cluster más grande del mapa.
 *
 * Ese número estuvo mal medido hasta la cuarta pasada. El filtro de keywords
 * tenía una regla que descartaba "tipos de" sin límite de palabra, y eso
 * matchea DENTRO de "logoTIPOS DE empresas": se comió 51 keywords y 2.780
 * búsquedas/mes, justamente las de menor competencia y mayor intención. Con eso
 * afuera la página parecía valer 1.330 y quedaba cuarta en prioridad.
 *
 * El cluster sigue partido en dos y la página sigue apuntando a una sola mitad.
 * Los términos de cabeza ("diseño de logo", "diseño de logotipos") son 1.000/mes
 * en competencia 57, con un SERP de generadores gratuitos y bancos de
 * plantillas: no es una pelea que un estudio gane, y el que la busca casi nunca
 * contrata.
 *
 * La otra mitad es la buena y es la que manda en el <title>: "logotipos de
 * empresas" son 1.000/mes en competencia 20 —la mejor relación volumen/
 * competencia de todo el relevamiento— más "logotipos empresas" (480, c18) y
 * una cola vertical (constructoras 140/c15, comida 110/c2, construcción 90/c12,
 * limpieza 70/c14) que la escribe alguien que ya tiene la empresa.
 *
 * La página existe separada de identidad de marca a propósito, aunque compartan
 * territorio: el lenguaje del que busca es distinto y meterlos juntos haría que
 * ninguna de las dos hable como habla su búsqueda. Se enlazan entre sí para que
 * quede claro cuál es cuál.
 */
import ServiceLayout from "../layouts/ServiceLayout.astro";
import Prose from "../components/astro/service/Prose.astro";
import Deliverables from "../components/astro/service/Deliverables.astro";
import ServiceStatement from "../components/astro/service/ServiceStatement.astro";
import { serviceHref } from "../data/services";
import { projectHref } from "../data/projects";
import type { FaqItem } from "../data/services";

const entrega = [
  {
    name: "Logotipo principal",
    detail:
      "La versión completa de la marca, dibujada en vectores y ajustada a mano en sus espacios y proporciones.",
  },
  {
    name: "Variantes de uso",
    detail:
      "Horizontal, vertical, isotipo suelto y versión reducida. Un logo que sólo existe en una forma falla en la primera aplicación que no tiene ese espacio.",
  },
  {
    name: "Versiones monocromas",
    detail:
      "Positivo, negativo y una tinta, para impresión económica, grabados, sellos y bordados.",
  },
  {
    name: "Reglas de aplicación",
    detail:
      "Área de resguardo, tamaño mínimo legible y usos incorrectos, documentados en una guía breve.",
  },
  {
    name: "Archivos finales",
    detail:
      "Vectores editables, PDF para imprenta y exportaciones en PNG y SVG para pantalla, con fondo transparente donde corresponde.",
  },
  {
    name: "Favicon y avatares",
    detail:
      "Los recortes cuadrados y circulares que piden el navegador y cada red social, resueltos por nosotros y no por el recorte automático de la plataforma.",
  },
];

// La cola vertical del cluster. No es relleno de SEO: son las búsquedas más
// baratas del mapa entero (competencia 2 a 15) y las escribe alguien que YA
// tiene la empresa, que es exactamente el lector que queremos. Cada rubro dice
// algo cierto sobre cómo cambia el trabajo, porque un párrafo genérico con el
// nombre del rubro cambiado se nota y no rankea.
const rubros = [
  {
    name: "Constructoras e industria",
    detail:
      "La marca termina en un cartel de obra, un casco y una camioneta antes que en una web. Se diseña para leerse a treinta metros y para sobrevivir a una sola tinta sobre vinilo.",
  },
  {
    name: "Gastronomía",
    detail:
      "Es el rubro donde el logo más se aplica sobre superficies difíciles: bolsas, vasos, packaging con calor, delivery. Necesita una versión reducida que aguante y una monocroma que no dependa del color.",
  },
  {
    name: "Servicios y limpieza",
    detail:
      "Marcas que compiten por confianza en un mercado con mucha informalidad. El trabajo pasa por parecer una empresa establecida en uniformes, facturas y vehículos.",
  },
  {
    name: "Profesionales y consultoras",
    detail:
      "Poca aplicación física y mucha firma de mail, propuesta y presentación. La tipografía pesa más que el símbolo, porque casi todo el uso es sobre documento.",
  },
];

const faqs: FaqItem[] = [
  {
    question: "¿Qué incluye el diseño de un logotipo para empresas?",
    answer:
      "El logotipo principal, sus variantes horizontal, vertical y reducida, las versiones monocromas, las reglas de área de resguardo y tamaño mínimo, y los archivos finales en vector y en formatos de pantalla. Un logo entregado en una sola versión y en un solo archivo se rompe en la primera aplicación que no coincide con esa forma.",
  },
  {
    question: "¿Alcanza con un logo o necesito una identidad completa?",
    answer:
      "Depende de cuántos puntos de contacto tenga la empresa. Con un logo alcanza cuando el uso es acotado y previsible. Cuando hay web, redes, papelería, señalética y varias personas produciendo piezas, el logo solo no ordena nada: lo que ordena es el sistema de color, tipografía y recursos que viene con la identidad de marca.",
  },
  {
    question: "¿Cuántas propuestas presentan?",
    answer:
      "Presentamos una propuesta desarrollada, con el argumento de por qué resuelve lo que se planteó, y trabajamos sobre ella. Mostrar cinco caminos a la vez suena generoso y es lo contrario: convierte la decisión en una elección de gusto entre opciones que nadie defendió en serio.",
  },
  {
    question: "¿Se puede registrar el logo que diseñan?",
    answer:
      "Sí, y conviene verificarlo antes de avanzar. Nosotros hacemos una búsqueda de antecedentes para no desarrollar sobre algo que ya está tomado, pero el registro ante el INPI lo tramita la empresa o su estudio jurídico, porque es un trámite legal y no de diseño.",
  },
  {
    question: "¿Hacen logotipos para un rubro en particular?",
    answer:
      "Trabajamos con cualquier rubro y el entregable es el mismo. Lo que cambia es dónde va a terminar aplicada la marca: una constructora la necesita legible en un cartel de obra y en una sola tinta, una marca gastronómica la necesita sobreviviendo a un packaging con calor, una consultora la usa casi sólo sobre documento. Esa diferencia se resuelve en el dibujo, no en el precio.",
  },
  {
    question: "¿Trabajan con emprendimientos o sólo con empresas grandes?",
    answer:
      "Con los dos. Lo que cambia entre un emprendimiento y una empresa con varias líneas no es la calidad del trabajo sino el alcance: cuántas aplicaciones hay que resolver y cuánta documentación necesita el equipo que después lo va a usar.",
  },
];
---

<ServiceLayout
  title="Logotipos de empresas: diseño de logo profesional | Zil Design"
  description="Diseño de logotipos de empresas en Argentina: variantes de uso, versiones monocromas, reglas de aplicación y archivos finales en vector, listos para imprenta y pantalla."
  slug="diseno-de-logo"
  breadcrumb="Diseño de logo"
  eyebrow="Diseño de logo"
  h1="Diseño de logotipos de empresas"
  lede="Dibujamos la marca gráfica de tu empresa y todas las versiones que va a necesitar, con las reglas para aplicarla sin romperla."
  heroBody="Logotipos de empresas y de negocios, entregados en vectores editables y en cada formato que pide el uso real: imprenta, pantalla, una tinta, bordado."
  faqs={faqs}
  ctaTitle="Hablemos de tu logo"
  ctaText="Contanos qué hace tu empresa y en qué contextos va a aparecer la marca."
>
  <Prose title="Un logo no es un archivo, es un sistema chico">
    <p>
      El error más común no es elegir mal la forma. Es encargar el logotipo como
      una sola imagen y descubrir después que hace falta en horizontal para el
      encabezado de la web, en cuadrado para el perfil de Instagram, en una
      tinta para el sello y en versión reducida para la etiqueta, y que ninguna
      de esas existe.
    </p>
    <p>
      Por eso entregamos la marca con sus variantes resueltas y con las reglas
      mínimas para usarlas. No es un manual completo, que es otro alcance, pero
      es lo suficiente para que la aplicación no dependa de que estemos
      disponibles para consultarnos.
    </p>
  </Prose>

  <Deliverables
    title="Qué entregamos"
    intro="El paquete completo de la marca gráfica, listo para usar en imprenta y en pantalla."
    items={entrega}
    offset={1}
  />

  <ServiceStatement
    lead="Un logo que existe en una sola versión falla en la"
    highlight="primera aplicación."
  />

  <Deliverables
    title="Logotipos por rubro"
    intro="El entregable es el mismo; lo que cambia es dónde termina aplicada la marca, y eso decide cómo se dibuja."
    items={rubros}
    numbered={false}
    offset={3}
  />

  <Prose title="Cuándo conviene ir por la identidad completa">
    <p>
      Si la empresa tiene varios puntos de contacto o varias personas
      produciendo piezas, el logo solo no alcanza para que todo se vea de la
      misma empresa. Lo que resuelve eso es el sistema: color, tipografía,
      recursos gráficos y la documentación que los ordena. Ese alcance está en{
        " "
      }
      <a href={serviceHref("identidad-de-marca")}
        >diseño de identidad de marca</a
      >.
    </p>
    <p>
      Podés ver marcas terminadas y aplicadas en{" "}
      <a href={projectHref("gelato")}>Gelato</a> y{" "}
      <a href={projectHref("clojure")}>Clojure</a>. Y si además necesitás el
      documento que ordena cómo se aplica todo, está{" "}
      <a href={serviceHref("manual-de-marca")}>manual de marca</a>.
    </p>
  </Prose>
</ServiceLayout>
