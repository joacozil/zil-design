---
import Button from "../components/astro/Button.astro";
import ZStage from "../components/astro/ZStage.astro";
import ClientsMarquee from "../components/react/ClientsMarquee.tsx";
import mmg from "../assets/img/mmg.svg";
import quantia from "../assets/img/quantia.svg";
import clojure from "../assets/img/clojure.svg";
import netValue from "../assets/img/net-value.svg";
import advantia from "../assets/img/advantia.svg";
import nu from "../assets/img/nu.svg";
import kfc from "../assets/img/kfc.svg";
import wendys from "../assets/img/wendys.svg";

// Client trust strip. `h` is a per-logo height class — logos are normalized by
// height, but some marks read smaller at the same height, so they get a larger
// value. Each one steps down two units on mobile: at 390px the tablet+ heights
// make the strip read as a row of BRANDS competing with the copy above it, when
// its job is quiet corroboration.
const logos = [
  { img: nu, alt: "Nu", h: "h-6 tablet:h-8" },
  { img: mmg, alt: "MMG Bank", h: "h-5 tablet:h-7" },
  { img: advantia, alt: "Advantia", h: "h-8 tablet:h-10" },
  { img: quantia, alt: "Quantia", h: "h-5 tablet:h-7" },
  { img: clojure, alt: "Clojure", h: "h-7 tablet:h-9" },
  { img: netValue, alt: "Net Value", h: "h-8 tablet:h-10" },
  { img: kfc, alt: "KFC", h: "h-6 tablet:h-8" },
  { img: wendys, alt: "Wendy's", h: "h-6 tablet:h-8" },
];

// Plain, serializable data for the marquee island. `ratio` feeds the marquee's
// `violet` tone, which draws each mark as a masked box and cannot read the
// intrinsic ratio from the file.
const marqueeLogos = logos.map(({ img, alt, h }) => ({
  src: img.src,
  alt,
  h,
  ratio: img.width / img.height,
}));
---

{
  /* Viewport-pinned hero: `min-h-svh` at EVERY size, so — like the other pinned
    sections — the section rhythm (`py-section`) does NOT apply here. See the
    rhythm note in styles/global.css.

    A GRAPHIC STAGE, NOT A PHOTO: the deep brand violet, with the brand's Z
    drawn across it as an outline. The glyph, its geometry and its self-drawing
    entrance all live in ZStage.astro — read that file before touching anything
    that registers on it. All this section owns is the copy laid over it, and
    the copy rises out of the finished line, held back by the
    `data-reveal-delay` on the grid below. Every timing lives in scripts/reveal.ts.

    ONE CENTERED COLUMN AT EVERY SIZE, REGISTERED ON THE HORIZON: headline →
    description → CTA → logo strip at the foot. The copy is NOT free-centred:
    the grid's first row ends exactly on the Z's horizon (50svh), the headline
    bottom-aligns into it, and the description opens just below — so the two
    horizon edges always thread the gap between headline and description, at
    every viewport, exactly as the reference composition argues. The diagonals
    pass under the text at low contrast. */
}
<section
  id="hero"
  class="relative flex min-h-svh w-full flex-col overflow-hidden bg-primary-dark"
>
  <ZStage />
  {
    /* `pt-24` is header clearance for the floating pill (~75px), NOT rhythm —
      measured, not negotiable. The grid's first row subtracts exactly this
      6rem from its 50svh height so the row's bottom edge lands ON the Z's
      horizon — change one without the other and the registration silently
      breaks. */
  }
  <div
    class="hero-grid relative z-10 mx-auto w-full max-w-8xl flex-1 px-6 pt-24 pb-9 tablet:px-8 tablet:pb-10 desktop:px-12 desktop:pb-12"
    data-reveal-group
    data-reveal-delay="0.62"
  >
    {
      /* THE LINE BREAKS ARE PINNED, NOT WRAPPED. Letting width decide them
        meant the headline re-flowed continuously as the viewport moved — a
        different composition every few pixels. Exactly two arrangements:

          mobile / tablet   El diseño como / herramienta / de negocio
          desktop           El diseño como / herramienta de negocio

        So: no `text-balance` (it re-distributes the lines we just fixed) and
        no max-width. `text-display` is fluid (see global.css), tuned so the
        longest pinned line clears its container at every width — if the copy
        ever changes, re-measure the clamp caps; nothing adapts on its own. */
    }
    {
      /* TWO WEIGHTS, ONE SENTENCE — 400 for the setup, 700 for the payoff, so
        the emphasis lands on what the agency actually sells instead of the
        whole line shouting equally. Both are overridden here rather than in the
        type scale: `text-display` carries 500 like every other role, and this
        headline is the one place that split exists.

        A `span`, not `strong`: this is typographic emphasis, not semantic
        importance, and `strong` would have a screen reader announce a stress
        that is not in the sentence.

        The bold half is ~1.7% wider than the same words at 500, which eats into
        what the `--text-display` cap reserves for it — see the clamp note in
        global.css before raising that cap. */
    }
    <h1
      class="hero-title text-display font-normal text-text-inverse"
      data-reveal
    >
      El diseño como<br /><span class="font-bold"
        >herramienta<br class="desktop:hidden" /> de negocio</span
      >
    </h1>

    <p
      class="hero-desc max-w-[34ch] text-p-lg text-pretty text-text-inverse tablet:max-w-[52ch]"
      data-reveal
    >
      Somos un estudio de diseño y branding en Argentina. Construimos sistemas
      visuales que aportan dirección, fortalecen el posicionamiento y potencian
      el valor percibido de tu marca.
    </p>

    {
      /* The reveal goes on the wrapper, not the Button: the pill owns its own
        hover choreography on transform/padding and must not share a transform
        with an entrance tween.

        The pill runs one step down on mobile, where the stage is short and
        the full-size CTA crowded the copy. Scoped to `max-tablet:` (NOT
        unprefixed) on purpose: these are `!important`, and applying them at
        every size would beat the variant's own `desktop:hover:pr-*` and kill
        the arrow-reveal growth. Below 640px there is no hover, so nothing is
        lost. */
    }
    {
      /* `href="#cta"` STAYS, and is not vestigial: ContactModal intercepts the
        click and opens the form right here, but with no JS the link still walks
        the reader to the real CTA section. The modal is an enhancement over a
        working link — see the header comment in ContactModal.astro. */
    }
    <div class="mt-8 tablet:mt-10" data-reveal>
      <Button
        href="#cta"
        data-track="cta_click"
        data-track-location="home-hero"
        variant="pill"
        class="max-tablet:py-3! max-tablet:pr-7! max-tablet:pl-7! max-tablet:text-p!"
        data-contact-modal-open
        aria-haspopup="dialog"
      >
        Hablemos de tu marca
      </Button>
    </div>

    {
      /* Client trust strip, closing the foot of the stage. The reveal stays on
        this server-rendered wrapper, never inside the Embla island; the wrapper
        also masks both edges so logos fade out rather than clip. The `violet`
        tone renders every mark in the brand's light violet — see the marquee. */
    }
    <div
      class="hero-logos hero-logos-fade mt-10 w-full self-end tablet:mt-12"
      data-reveal
    >
      <ClientsMarquee client:load logos={marqueeLogos} tone="violet" />
    </div>
  </div>
</section>

<style>
  /* --- Content grid ----------------------------------------------------------
     Four rows registered on the graphic, not free-centred:

       1  minmax(min-content, 50svh − 6rem)   headline, bottom-aligned — the
                                              row ends exactly on the horizon
       2  auto                                description
       3  auto                                CTA
       4  1fr                                 open stage; logos pin to its end

     The 6rem is the container's own pt-24 (see the markup comment), so row 1's
     bottom edge = 50svh = the Z's horizon at any viewport. minmax lets the row
     grow instead of clipping if the headline ever outgrows the zone (short
     landscape phones). */
  .hero-grid {
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: minmax(min-content, calc(50svh - 6rem)) auto auto 1fr;
    justify-items: center;
    text-align: center;

    /* The air between the horizon and the copy on EITHER side of it. One token
       for both, because the two gaps must read as equal — the line sits
       between the headline and the description, and any asymmetry makes it
       look like it belongs to whichever one it is nearer. */
    --z-copy-gap: 1.5rem;
  }

  /* BOTH GAPS ARE MEASURED FROM THE TEXT, NOT FROM THE BOX — that is the whole
     reason these two are calc()s instead of the same flat value.

     A line box is taller than its text: the leading is split evenly above and
     below, so `half-leading = (line-height − 1) / 2` of dead space sits inside
     the box edge before any letter starts. The headline and the description
     have very different leading (1.04 vs 1.55), so giving them an equal
     padding/margin produces visibly UNEQUAL gaps — measured on a 390px phone,
     a 16px padding and a 24px margin rendered as 17px above the line and 28px
     below it, and the line read as belonging to the description.

     Subtracting each element's own half-leading cancels that dead space, so
     both gaps end up exactly --z-copy-gap from the actual type. The subtraction
     is written in `em` deliberately: `em` resolves against the element's OWN
     font-size, so each stays correct as the type scale steps at the
     breakpoints, with no second set of numbers to keep in sync. The two
     constants are just (line-height − 1) / 2 for each role — re-derive them if
     a line-height in global.css ever changes. */
  .hero-title {
    align-self: end;
    /* text-display, line-height 1.04 → (1.04 − 1) / 2 = 0.02em */
    padding-bottom: calc(var(--z-copy-gap) - 0.02em);
  }

  .hero-desc {
    /* text-p-lg, line-height 1.55 → (1.55 − 1) / 2 = 0.275em */
    margin-top: calc(var(--z-copy-gap) - 0.275em);
  }

  @media (width >= 640px) {
    .hero-grid {
      --z-copy-gap: 2rem;
    }
  }

  /* Soften the marquee's left/right edges: logos ease out into the surface
    instead of ending on a hard cut at the container edge. */
  .hero-logos-fade {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
  }
</style>
