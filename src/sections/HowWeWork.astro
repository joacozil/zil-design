---
import MetodoZil from "../components/react/MetodoZil.tsx";
---

{/* Pinned mark that switches through the three states */}
<section>
  {
    /* Target of the "Cómo trabajamos" nav link — lands on the mark itself, not
      on the claim that precedes it. Empty and zero-height, so it sits exactly at
      the pinned stage's top without affecting its layout or pin start.

      No `.scroll-anchor` here, and NOT an oversight. That class offsets by
      `--spacing-section` because every other anchor sits inside its section's
      padded container and has to cancel that padding to land the section edge at
      the top. This stage is viewport-pinned and exempt from `py-section` (see
      CLAUDE.md), so this div already sits ON the section's top edge — adding the
      offset would push the landing a full section-padding PAST the pin start and
      leave the stage mid-transition, which is the one thing it cannot afford. */
  }
  <div id="how-we-work"></div>
  <MetodoZil client:load />
</section>
