---
/**
 * CampaignCollage — a three-tile collage: two coloured panels stacked in the left
 * column and one full-height photograph on the right.
 *
 * The two left tiles are COLOUR FIELDS, not images: their artwork ships as a
 * cut-out on transparency, so the rectangle behind it is CSS (`panelBg` /
 * `graphicBg`). That is what lets the phone BREAK ITS BOX — it is a normal child
 * of the panel, positioned against the panel's bottom edge and taller than the
 * panel, so it overflows past the top edge and paints over whatever is above.
 * Baking the rectangle into the asset would make that impossible.
 *
 * Layout is `grid-template-areas`, so the reading order in the markup (panel →
 * photo → graphic) is also the MOBILE stacking order, while the desktop grid
 * places the photo alongside spanning both rows. Nothing has to be reordered.
 *
 * Tile proportions come from the design as explicit `aspect-ratio`s rather than
 * `fr` rows: the tiles' heights are what size the grid, and an `fr` row would
 * make that circular. The photo then simply stretches to whatever the left
 * column adds up to.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Tile {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  /** Top-left tile. Its artwork overflows the top edge of the panel. */
  panel: Tile;
  /**
   * Fill colour behind the panel artwork.
   *
   * Omit it when the FIELD IS PART OF THE ARTWORK — a gradient, a texture,
   * anything CSS would have to reproduce. The artwork then spans the tile's
   * full width with its own ground flush to the tile's foot, and whatever the
   * artwork carries above that ground stands above the tile. How much is the
   * asset's own business: the tile's ratio is the ground's, the artwork's is
   * taller, and the difference IS the overhang — nothing to re-state here.
   */
  panelBg?: string;
  /** Bottom-left tile — artwork centred inside its colour field. */
  graphic: Tile;
  /** Fill colour behind the graphic artwork. Omit it when the tile IS the artwork. */
  graphicBg?: string;
  /** Right tile — a photograph, full height of the left column. */
  photo: Tile;
  /**
   * The tiles' proportions, `width / height`. They are what size the grid — an
   * `fr` row would make that circular — so they come from the artwork rather
   * than from a house figure, and each collage states its own.
   */
  panelRatio?: number;
  graphicRatio?: number;
  /** The photograph's own proportion, used only in the MOBILE stack. */
  photoRatio?: number;
  /** The two columns' split at `tablet` and up. */
  columns?: string;
}
const {
  panel,
  panelBg,
  graphic,
  graphicBg,
  photo,
  panelRatio = 755 / 510,
  graphicRatio = 755 / 400,
  photoRatio = 1714 / 2146,
  columns = "755fr 782fr",
} = Astro.props;
---

<section class="py-section" aria-label="Piezas de campaña">
  <div class="mx-auto w-full max-w-8xl px-6 tablet:px-8 desktop:px-12">
    <div
      class="cc-grid"
      style={`--cc-cols:${columns};--cc-panel-ratio:${panelRatio};--cc-graphic-ratio:${graphicRatio};--cc-photo-ratio:${photoRatio}`}
    >
      {/* Panel — the artwork breaks out past the top edge. */}
      <div
        class="cc-panel"
        style={panelBg ? `background-color:${panelBg}` : undefined}
      >
        <Image
          src={panel.src}
          alt={panel.alt}
          sizes="(min-width: 640px) 40vw, 80vw"
          class:list={["cc-panel-art", !panelBg && "cc-panel-art--bleed"]}
        />
      </div>

      {/* Photo — spans both rows on the right at tablet+. */}
      <div class="cc-photo">
        <Image
          src={photo.src}
          alt={photo.alt}
          sizes="(min-width: 640px) 50vw, 100vw"
          class="cc-photo-img"
        />
      </div>

      {/* Graphic — artwork centred in its colour field, or the tile itself. */}
      <div
        class="cc-graphic"
        style={graphicBg ? `background-color:${graphicBg}` : undefined}
      >
        <Image
          src={graphic.src}
          alt={graphic.alt}
          sizes="(min-width: 640px) 42vw, 85vw"
          class:list={["cc-graphic-art", !graphicBg && "cc-graphic-art--full"]}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .cc-grid {
    display: grid;
    gap: clamp(0.75rem, 1vw, 1rem);
    grid-template-areas:
      "panel"
      "photo"
      "graphic";
  }
  /* Grid items default to `min-width: auto`, which floors a column at its
     content's intrinsic width — here the images' full pixel widths. That floor
     outranks the `fr` ratio below and silently inverted the column split (the
     left column came out WIDER than the right). Zeroing it lets the declared
     proportions actually hold. */
  .cc-grid > * {
    min-width: 0;
  }

  /* The panel clips nothing: the artwork is meant to escape its top edge. */
  .cc-panel {
    grid-area: panel;
    position: relative;
    aspect-ratio: var(--cc-panel-ratio);
  }
  .cc-panel-art {
    position: absolute;
    /* Anchored to the BOTTOM and taller than the panel, so the overflow lands on
       top — the design's "phone rising out of the block". */
    bottom: 10%;
    left: 50%;
    width: 80%;
    height: auto;
    transform: translateX(-50%);
  }
  /* A baked field: the artwork spans the tile and carries its own ground, so it
     is pinned by that ground's foot and overhangs the tile by whatever more it
     is tall. */
  .cc-panel-art--bleed {
    bottom: 0;
    left: 0;
    width: 100%;
    transform: none;
  }

  .cc-graphic {
    grid-area: graphic;
    display: grid;
    place-items: center;
    aspect-ratio: var(--cc-graphic-ratio);
  }
  .cc-graphic-art {
    width: 85%;
    height: auto;
  }
  /* No colour field of its own: the artwork IS the tile. */
  .cc-graphic-art--full {
    width: 100%;
  }

  .cc-photo {
    grid-area: photo;
    position: relative;
    /* Mobile: the photo carries its own proportion. At tablet+ it drops the ratio
       and stretches to whatever the left column adds up to. */
    aspect-ratio: var(--cc-photo-ratio);
    overflow: hidden;
  }
  /* Absolute, so the photograph contributes NO intrinsic height. Left in flow it
     would size the rows itself (a percentage height against an auto-height grid
     area falls back to the image's own ratio), pushing the rows taller than the
     panel and graphic need and leaving the two columns ending at different
     heights. Out of flow, the row heights come only from the tiles' aspect
     ratios above and the photo simply stretches to fill the span. */
  .cc-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (width >= 640px) {
    .cc-grid {
      /* Slightly wider right column, as in the design. */
      grid-template-columns: var(--cc-cols);
      grid-template-areas:
        "panel photo"
        "graphic photo";
    }
    .cc-photo {
      aspect-ratio: auto;
    }
  }
</style>
