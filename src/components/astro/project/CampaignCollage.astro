---
/**
 * CampaignCollage — a three-tile collage: two coloured panels stacked in the left
 * column and one full-height photograph on the right.
 *
 * The two left tiles are COLOUR FIELDS, not images: their artwork ships as a
 * cut-out on transparency, so the rectangle behind it is CSS (`panelBg` /
 * `graphicBg`). That is what lets the phone BREAK ITS BOX — it is a normal child
 * of the panel, positioned against the panel's bottom edge and taller than the
 * panel, so it overflows past the top edge and paints over whatever is above.
 * Baking the rectangle into the asset would make that impossible.
 *
 * Layout is `grid-template-areas`, so the reading order in the markup (panel →
 * photo → graphic) is also the MOBILE stacking order, while the desktop grid
 * places the photo alongside spanning both rows. Nothing has to be reordered.
 *
 * Tile proportions come from the design as explicit `aspect-ratio`s rather than
 * `fr` rows: the tiles' heights are what size the grid, and an `fr` row would
 * make that circular. The photo then simply stretches to whatever the left
 * column adds up to.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Tile {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  /** Top-left tile. Its artwork overflows the top edge of the coloured panel. */
  panel: Tile;
  /** Fill colour behind the panel artwork. */
  panelBg: string;
  /** Bottom-left tile — artwork centred inside its colour field. */
  graphic: Tile;
  /** Fill colour behind the graphic artwork. */
  graphicBg: string;
  /** Right tile — a photograph, full height of the left column. */
  photo: Tile;
}
const { panel, panelBg, graphic, graphicBg, photo } = Astro.props;
---

<section class="py-section" aria-label="Piezas de campaña">
  <div class="mx-auto w-full max-w-8xl px-6 tablet:px-8 desktop:px-12">
    <div class="cc-grid">
      {/* Panel — the phone breaks out past the top edge. */}
      <div class="cc-panel" style={`background-color:${panelBg}`}>
        <Image
          src={panel.src}
          alt={panel.alt}
          sizes="(min-width: 640px) 40vw, 80vw"
          class="cc-panel-art"
        />
      </div>

      {/* Photo — spans both rows on the right at tablet+. */}
      <div class="cc-photo">
        <Image
          src={photo.src}
          alt={photo.alt}
          sizes="(min-width: 640px) 50vw, 100vw"
          class="cc-photo-img"
        />
      </div>

      {/* Graphic — artwork centred in its colour field. */}
      <div class="cc-graphic" style={`background-color:${graphicBg}`}>
        <Image
          src={graphic.src}
          alt={graphic.alt}
          sizes="(min-width: 640px) 42vw, 85vw"
          class="cc-graphic-art"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .cc-grid {
    display: grid;
    gap: clamp(0.75rem, 1vw, 1rem);
    grid-template-areas:
      "panel"
      "photo"
      "graphic";
  }
  /* Grid items default to `min-width: auto`, which floors a column at its
     content's intrinsic width — here the images' full pixel widths. That floor
     outranks the `fr` ratio below and silently inverted the column split (the
     left column came out WIDER than the right). Zeroing it lets the declared
     proportions actually hold. */
  .cc-grid > * {
    min-width: 0;
  }

  /* The panel clips nothing: the artwork is meant to escape its top edge. */
  .cc-panel {
    grid-area: panel;
    position: relative;
    aspect-ratio: 755 / 510;
  }
  .cc-panel-art {
    position: absolute;
    /* Anchored to the BOTTOM and taller than the panel, so the overflow lands on
       top — the design's "phone rising out of the block". */
    bottom: 10%;
    left: 50%;
    width: 80%;
    height: auto;
    transform: translateX(-50%);
  }

  .cc-graphic {
    grid-area: graphic;
    display: grid;
    place-items: center;
    aspect-ratio: 755 / 400;
  }
  .cc-graphic-art {
    width: 85%;
    height: auto;
  }

  .cc-photo {
    grid-area: photo;
    position: relative;
    /* Mobile: the photo carries its own proportion. At tablet+ it drops the ratio
       and stretches to whatever the left column adds up to. */
    aspect-ratio: 1714 / 2146;
    overflow: hidden;
  }
  /* Absolute, so the photograph contributes NO intrinsic height. Left in flow it
     would size the rows itself (a percentage height against an auto-height grid
     area falls back to the image's own ratio), pushing the rows taller than the
     panel and graphic need and leaving the two columns ending at different
     heights. Out of flow, the row heights come only from the tiles' aspect
     ratios above and the photo simply stretches to fill the span. */
  .cc-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (width >= 640px) {
    .cc-grid {
      /* Slightly wider right column, as in the design. */
      grid-template-columns: 755fr 782fr;
      grid-template-areas:
        "panel photo"
        "graphic photo";
    }
    .cc-photo {
      aspect-ratio: auto;
    }
  }
</style>
