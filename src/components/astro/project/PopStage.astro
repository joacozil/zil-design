---
/**
 * PopStage — the campaign off the screen and into the shop: its lockup on a
 * field of its own name, and then the places the work actually landed,
 * photographed.
 *
 * Two halves that answer each other. The HEAD is drawn work — flat colour, a
 * repeated wordmark, a lockup — and is a picture: a canvas carrying its own
 * ratio, every piece placed as a share of its WIDTH, so it scales as one thing.
 * The SHOTS are photographs of the same work in the world, butted edge to edge
 * with no field between them, because the point is that the campaign covers the
 * place rather than that each photograph is a piece.
 *
 * The shop front belongs to the FIRST half even though it is a photograph: it
 * is cut out of its sky, so the field is what it stands against and the tiling
 * carries on behind its roofline. That is the join between the two.
 *
 * The copy is the one thing here that does not scale: it is read, not looked
 * at. On the canvas at `desktop`, where the artboard puts it; below that it
 * steps out into the flow, because a 26% column of body text on a phone is four
 * words wide.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Shot {
  src: ImageMetadata;
  alt: string;
}
interface RowShot extends Shot {
  /** Share of the row's width. The artboard's own measurement. */
  weight: number;
}
interface Props {
  /** The flat field the head stands on. */
  field: string;
  /** The campaign's name, tiled behind everything. */
  word: ImageMetadata;
  /** How visible that tiling is against the field. */
  wordOpacity?: number;
  /** The lockup: the character, the line, the logo. */
  cartel: Shot;
  /** The copy. The label is a chip; the body sits under it. */
  label: string;
  body: string;
  /** The shop front, full bleed. */
  local: Shot;
  /** The in-place shots, left to right. */
  row: RowShot[];
  /** The dining room, full bleed, closing the run. */
  banner: Shot;
  /** Section landmark label. */
  ariaLabel?: string;
}
const {
  field,
  word,
  wordOpacity = 0.07,
  cartel,
  label,
  body,
  local,
  row,
  banner,
  ariaLabel = "Material POP",
} = Astro.props;

/* ── The artboard, in its own units ──────────────────────────────────────────
   page      464 wide
   head      402 tall
   wordmark  tiled, 209 wide — its own ratio then sets the leading
   cartel    x 24, y 53, 416 wide
   copy      y 319; across, the page's container rather than the artboard's x 61
   local     the photograph's own ratio once its empty sky is trimmed
   row       the pieces at a common height of 200, side by side
   banner    234 tall
   The row's cells are weighted by what each photograph is worth at that
   height — the artboard's 79 / 149 / 229, and 178 for the one added since.
   Divided through by 464 below. */
const HEAD_RATIO = 464 / 402;
/**
 * In a column the canvas carries only the LOCKUP — the artboard's height was
 * cut for a hand that is no longer in it, and held here it leaves a third of
 * the band empty between the bubble and the copy. The lockup's own foot is at
 * 55.7 of the width, so the canvas ends a little under that and the copy's own
 * step supplies the rest of the gap.
 */
const HEAD_RATIO_NARROW = 100 / 63;
/* The tiling, in shares of the page's width.
   The leading is ZERO: the artwork is 861 × 137 with air of its own above and
   below the caps, so the rows butt and the gap you see is the artwork's.
   Across, they need 2.1 of their own.

   And the row has to COME OUT EVEN. The artboard sets the word near 44, which
   is two and a sixth across the page — so every row ended on a sixth of a word
   at the right edge, and a name tiled as a texture that is never once whole
   reads as a mistake. The width is taken from the count instead: two words and
   the one gap between them, filling the page exactly. */
const TILE_COLS = 2;
/* Off the page's edges by the same distance that separates two words, so the
   rhythm across a row is even: margin, word, gap, word, margin. */
const TILE_PAD = 2.1;
const PAGE_GAP = 2.1;
/* Inside the strip everything is a share of the STRIP, not of the page, so the
   gap has to be converted before the width can be taken from it. */
const TILE_W = 100 - 2 * TILE_PAD;
const WORD_GAP = (PAGE_GAP / TILE_W) * 100;
const WORD = (100 - (TILE_COLS - 1) * WORD_GAP) / TILE_COLS;
const TILE_TOP = 3.8;
const TILE_ROWS = 24;

const rowTotal = row.reduce((n, s) => n + s.weight, 0);
---

<section class="ps" style={`--ps-field:${field}`} aria-label={ariaLabel}>
  <div
    class="ps-head"
    style={`--ps-word-w:${WORD}%;--ps-word-gap:${WORD_GAP}%;--ps-word-pad:${TILE_PAD}%;--ps-word-top:${TILE_TOP}cqw;--ps-word-opacity:${wordOpacity};--ps-ratio:${HEAD_RATIO};--ps-ratio-narrow:${HEAD_RATIO_NARROW}`}
  >
    {
      /* The tiling is its own layer rather than the head's background: it has to
        be faded, and fading the head would take the field with it. */
    }
    <div class="ps-tile" aria-hidden="true">
      {
        Array.from({ length: TILE_ROWS }).map(() => (
          <div class="ps-tile-row">
            {Array.from({ length: TILE_COLS }).map(() => (
              <img src={word.src} alt="" loading="lazy" />
            ))}
          </div>
        ))
      }
    </div>

    <div class="ps-canvas">
      <img
        class="ps-cartel"
        src={cartel.src.src}
        alt={cartel.alt}
        loading="lazy"
      />

    </div>

    <div class="ps-copy">
      <h3 class="ps-label">{label}</h3>
      <p class="ps-body">{body}</p>
    </div>

    {
      /* The shop front belongs to the HEAD, not to the run of photographs: it
        is cut out of its sky, so the field is what it stands against and the
        tiling has to carry on behind it. Put it after the head and the page's
        own white shows through its roofline. */
    }
    <Image
      class="ps-shot ps-shot--local"
      src={local.src}
      alt={local.alt}
      loading="lazy"
      sizes="100vw"
    />
  </div>

  <div class="ps-shots">
    <div class="ps-row">
      {
        row.map((s) => (
          <Image
            class="ps-shot ps-shot--cell"
            style={`--w:${s.weight}`}
            src={s.src}
            alt={s.alt}
            loading="lazy"
            sizes={`${Math.round((s.weight / rowTotal) * 100)}vw`}
          />
        ))
      }
    </div>

    <Image
      class="ps-shot ps-shot--banner"
      src={banner.src}
      alt={banner.alt}
      loading="lazy"
      sizes="100vw"
    />
  </div>
</section>

<style>
  /* The field is the SECTION's, not the head's: the run of photographs leaves a
     gap round and between its pieces, and what shows through there has to be
     the campaign's own colour rather than the page's white. */
  .ps {
    position: relative;
    background-color: var(--ps-field);
  }

  /* The field, and the frame the copy is placed against. `container-type` is
     what lets every measurement inside be a share of its WIDTH — the vertical
     ones included, which is why they are `cqw` and not per cent. */
  .ps-head {
    position: relative;
    container-type: inline-size;
  }

  /* The picture itself, carrying the artboard's ratio. It does NOT clip: the
     hand has to fall out of it onto the photograph below. Separating it from
     the head is what lets the copy stand under the picture on a phone and sit
     inside it at `desktop` without either layout fighting the ratio. */
  .ps-canvas {
    position: relative;
    aspect-ratio: var(--ps-ratio-narrow);
  }

  /* The name, tiled. A texture — the lockup says it in full — so it carries no
     alternative text.

     Laid as rows of `<img>`, not as a repeated background: the artwork's box is
     tight to its glyphs, and a repeated background can only butt its tiles, so
     the words would run into one another with no way to part them. A row with a
     `column-gap` is the only place that gap can live.

     It clips itself rather than letting the head do it, because the head must
     NOT clip — the hand falls out of it onto the photograph below. */
  .ps-tile {
    position: absolute;
    inset: var(--ps-word-top) var(--ps-word-pad) 0;
    /* Over the whole head, the shop front included — so the texture does not
       stop at a line the picture has no reason to draw. */
    overflow: clip;
    opacity: var(--ps-word-opacity);
  }

  .ps-tile-row {
    display: flex;
    column-gap: var(--ps-word-gap);
  }

  .ps-tile-row img {
    flex: 0 0 var(--ps-word-w);
    /* A flex item's automatic minimum is its content size, and an image's is
       its intrinsic width — without this floor the row runs at the SVG's own
       861px. */
    min-width: 0;
    width: var(--ps-word-w);
    height: auto;
  }

  .ps-cartel,
  .ps-copy {
    position: absolute;
  }

  .ps-cartel {
    left: 5.17%;
    top: 11.42cqw;
    width: 89.66%;
    height: auto;
  }

  /* Below `desktop` the copy stands under the picture, in the page's own
     column — see the file's header. */
  .ps-copy {
    position: relative;
    margin-inline: auto;
    width: 100%;
    max-width: var(--container-8xl);
    padding: var(--spacing-section-tight) 1.5rem var(--spacing-section-tight);
  }

  .ps-label {
    display: inline-block;
    padding: 0.35em 0.7em;
    background-color: #ffffff;
    color: var(--ps-field);
    font-size: var(--text-p-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ps-body {
    margin-top: 1rem;
    max-width: 24rem;
    color: #ffffff;
    font-size: var(--text-p-sm);
    text-wrap: pretty;
  }

  /* The run of photographs, as a gallery: FULL WIDTH, with `--gap-piece` all
     the way round and between the pieces — the site's own seam, the same one
     the mosaics and collages of every other project are set to. Not the page's
     container: these are photographs of a place, and the place is what runs to
     the edges; the gap is there to say where one stops and the next starts, not
     to put them on the text's margins. The shop front above is NOT part of the
     run — that one is cut out of its sky and belongs to the head. */
  .ps-shots {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gap-piece);
    margin-top: var(--gap-piece);
    width: 100%;
    padding: 0 var(--gap-piece) var(--gap-piece);
  }

  .ps-shot {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* The shop front belongs to the HEAD, not to the gallery: it is cut out of
     its sky and stands on the field with the tiling behind its roofline. So it
     keeps the head's full bleed and does NOT take the gallery's margin.

     POSITIONED, so it paints with the tiling instead of under it: an in-flow
     replaced element always loses to a positioned one, and the words were
     landing on the building's roof. Both at `z-index: auto` now, so the source
     order decides and the front comes after — and where the artwork is clear,
     which is everything above its roofline, the words still show through.

     Its band is the photograph's OWN ratio, not the artboard's taller one: the
     difference between them was empty sky, and all it did was push the shop
     front away from the copy. */
  .ps-shot--local {
    position: relative;
    aspect-ratio: 2000 / 1022;
  }

  .ps-shot--banner {
    aspect-ratio: 464 / 234;
  }

  /* The row's ratio is the SUM of its pieces at one height: each weight starts
     from that photograph's own width at 200, so the three come to 531 and the
     band is 464 ÷ 531 of it. Set that way a cell lands on its natural width and
     is not cropped — which is what lets the shop front show its sign whole
     rather than cut down the middle.

     The weights may then be traded BETWEEN pieces without touching the band:
     what one gives up the next takes, the sum holds, and only the two that
     changed are re-framed. The hand hands some of its width to the shop front
     that way. */
  /* Below `desktop` the three STACK, each at its own full width: side by side
     in a column they come to a third of a phone each, which is a thumbnail of
     a place rather than the place. Nothing is cropped there — each photograph
     keeps the ratio it was taken at. */
  .ps-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-piece);
  }

  @media (min-width: 40rem) {
    .ps-copy {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .ps-canvas {
      aspect-ratio: var(--ps-ratio);
    }

    /* The band as the artboard has it: the three side by side, weighted, and
       the row's ratio the sum of them at one height. */
    .ps-row {
      flex-direction: row;
      aspect-ratio: 531 / 200;
      /* A flex ITEM's automatic minimum is its content, and the three photos'
         intrinsic heights are far taller than the band — without this floor
         removed they win over the ratio and the row comes out a fifth too
         tall. */
      min-height: 0;
    }

    .ps-shot {
      height: 100%;
    }

    .ps-shot--cell {
      flex: var(--w) 1 0;
      /* A flex item's automatic minimum is its content size, and a photo's is
         its intrinsic width — without this floor removed the row refuses to
         split by weight. */
      min-width: 0;
    }

    /* The copy takes its place on the canvas — but only its HEIGHT comes from
       the canvas. Across, it stays in the page's container like every other
       block of text on the site: the artboard's own 13.15% is inside the
       container at this width and outside it at 1920, where the container has
       stopped growing and the per cent has not. Copy is read, and what it is
       read against is the page's measure, not the picture's. */
    .ps-copy {
      position: absolute;
      top: 68.75cqw;
      right: 0;
      left: 0;
      margin-inline: auto;
      padding: 0 3rem;
    }
  }
</style>
