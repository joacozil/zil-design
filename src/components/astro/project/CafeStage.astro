---
/**
 * CafeStage — a sub-brand's own stretch of page: the place it is sold in, the
 * phones that sell it, and a run of its posts closing the band.
 *
 * Three beats on ONE field:
 *
 *   1. The photograph, full bleed from the section's head, fading out into the
 *      field rather than ending at an edge. Masked, not overlaid with a
 *      gradient — the same call CampaignStage makes, and for the same reason:
 *      there is no second colour to keep in step with the field.
 *   2. A canvas where the hand and the phones overlap. Both are placed as
 *      shares of it, so the hand stays in front of the group rather than
 *      drifting off it. The canvas holds at EVERY width: the overlap is the
 *      picture, so it scales rather than reflows.
 *   3. The posts, a row wider than the page: the two at the ends are cut by
 *      the screen, which is what says the run continues.
 *
 * Everything is a share of the section's WIDTH. Nothing here is a length.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Piece {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  /** The flat field the whole stretch stands on. */
  field: string;
  /** The place. Fades out into the field at its foot. */
  photo: Piece;
  /** The hand holding a phone, at the left and in front. */
  hand: Piece;
  /** The group of phones it stands in front of. */
  phones: Piece;
  /** The posts. The row runs wider than the page, so the ends are cut. */
  posts: Piece[];
  /** Section landmark label. */
  ariaLabel?: string;
}
const {
  field,
  photo,
  hand,
  phones,
  posts,
  ariaLabel = "Wendy's Café",
} = Astro.props;
---

<section class="cf" style={`--cf-field:${field}`} aria-label={ariaLabel}>
  <div class="cf-photo" aria-hidden="true">
    <Image src={photo.src} alt="" loading="lazy" sizes="100vw" />
  </div>

  <div class="cf-stage">
    <Image
      class="cf-phones"
      src={phones.src}
      alt={phones.alt}
      loading="lazy"
      sizes="57vw"
    />
    <Image
      class="cf-hand"
      src={hand.src}
      alt={hand.alt}
      loading="lazy"
      sizes="39vw"
    />
  </div>

  <div class="cf-posts">
    {
      posts.map((p) => (
        <Image
          class="cf-post"
          src={p.src}
          alt={p.alt}
          loading="lazy"
          sizes="21vw"
        />
      ))
    }
  </div>
</section>

<style>
  /* ── The artboard, in its own units ──────────────────────────────────────
     page      768 wide
     photo     full bleed, 520 tall, fading out over its last sixth
     stage     768 × 718: phones at 37.1% / 36.3%, 56.6% wide
                          hand at the left edge / 45.4%, 39.1% wide
     posts     21.2% each with 1.82% between, centred — the row comes to 113%
               of the page, so an end is cut on either side
     Shares of the section's width, its heights included. */
  .cf {
    position: relative;
    container-type: inline-size;
    background-color: var(--cf-field);
    /* Clipped on both axes: the photograph's box is a share of the width while
       the section's height is its content, so on a wide enough screen the one
       outgrows the other. */
    overflow: clip;
    /* The run of posts ends ON the field, so the section owes the gap to
       whatever follows. Only the foot: the head of this section is the
       photograph, which butts against the band above it on purpose. The band
       that follows is a full-bleed picture and contributes nothing, so this
       half is the whole gap. */
    padding-bottom: var(--spacing-section);
  }

  .cf-photo {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 67.7cqw; /* 520 / 768 */
    /* Opaque until its last sixth, then gone. The field takes over with no
       edge between them. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 84%,
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, #000 0%, #000 84%, transparent 100%);
  }

  .cf-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Below `desktop` the canvas gives way to a STACK, and the two pieces are
     set large: held at a phone's width the overlap puts a 150px hand in front
     of a 220px group, which is a diagram of the scene rather than the scene.
     The hand leads and runs off the LEFT edge — the same cut the canvas gives
     it, now against the screen instead of against the group. */
  .cf-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-section-tight);
    /* Clear of the SCREENS in the photograph above. The photograph is placed
       absolutely and takes 67.7 of the width, so the stack has to be told where
       it ends — and the hand has to start below the menu boards rather than
       across them, which is the one thing in the shot the hand is there to
       echo. */
    padding-top: 48cqw;
    width: 100%;
  }

  .cf-hand {
    order: -1;
    margin-left: -18%;
    width: 96%;
    height: auto;
  }

  /* The group is work to be read, so it takes the page's own column — the
     hand is the one that runs off the edge, and it does so on purpose. */
  .cf-phones {
    margin-inline: auto;
    width: calc(100% - 2 * var(--gutter));
    height: auto;
  }

  /* The run of posts. It is WIDER than the page by design — the row comes to
     113% of it — so the two at the ends are cut by the screen. */
  /* The run of posts SCROLLS below `desktop`. Two and a half pieces wide: the
     half is what says the row continues, with no arrows or dots to keep in step
     with a count. The leading edge carries the page's gutter, so the first post
     starts where the text does, and snapping to `start` lands each one back on
     that line. The scrollbar is hidden because the half piece already states
     the affordance. */
  .cf-posts {
    position: relative;
    display: flex;
    gap: var(--gap-piece);
    /* A step off the stack above: the track is its own beat of the section,
       not the foot of the one before it. */
    margin-top: var(--spacing-section-tight);
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--gutter);
    padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .cf-posts::-webkit-scrollbar {
    display: none;
  }

  .cf-post {
    flex: 0 0 calc((100vw - var(--gutter) - 2 * var(--gap-piece)) / 2.5);
    scroll-snap-align: start;
    /* A flex item's automatic minimum is its content size, and an image's
       content is its intrinsic width — without this floor removed every post
       renders at its full 865px and the row runs away. */
    min-width: 0;
    height: auto;
  }

  @media (min-width: 64rem) {
    /* The canvas as the artboard composes it: the hand in front of the group,
       both placed as shares of it, and the hand's own cut falling outside the
       page rather than against the screen's left edge. */
    .cf-stage {
      display: block;
      aspect-ratio: 768 / 718;
      padding-top: 0;
    }

    .cf-stage > :global(*) {
      position: absolute;
    }

    .cf-phones {
      top: 36.3%;
      left: 37.1%;
      margin-inline: 0;
      width: 56.6%;
    }

    .cf-hand {
      order: 0;
      top: 45.4%;
      left: 0;
      margin-left: 0;
      width: 39.1%;
    }

    /* The row WIDER than the page, cut at both ends — not a track. */
    .cf-posts {
      justify-content: center;
      gap: 1.82%;
      margin-top: 0;
      width: 113.3%;
      margin-inline: -6.65%;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-inline: 0;
    }

    .cf-post {
      flex: 0 0 18.7%; /* 21.2 of the page, as a share of this 113.3% row */
      scroll-snap-align: none;
    }
  }
</style>
