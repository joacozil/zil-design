---
/**
 * SocialCarousel — the "Redes Sociales" section: the project's feed rendered as
 * Instagram-style post cards (avatar bar, image, like/comment/share + save row).
 *
 * · Mobile / tablet — a swipeable carousel (native scroll-snap) with a peek of the
 *   next card and a dot indicator, so it reads as slidable without JS. A small
 *   progressive-enhancement script lights the active dot and lets dots scroll.
 * · Desktop — the same cards laid out as a static three-column grid.
 *
 * The cards are pure chrome; each post's artwork is the supplied image.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Post {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  label: string;
  body: string;
  posts: Post[];
  /** Section field colour. Default: Gelato's cream. */
  fieldBg?: string;
  /** Full-bleed rule opening the field. Pass `false` for no rule. Default: Gelato's brown. */
  rule?: string | false;
  /** Avatar dot in the card's top bar. Default: Gelato's brown. */
  avatarColor?: string;
  /** Like / comment / share / save icons. Default: Gelato's muted brown. */
  iconColor?: string;
}
const {
  label,
  body,
  posts,
  // Defaults ARE Gelato's values, so that page renders unchanged without passing
  // anything; a project with its own palette overrides them.
  fieldBg = "#fffaee",
  rule = "#896451",
  avatarColor = "#896451",
  iconColor = "#a98d7d",
} = Astro.props;

const optimized = await Promise.all(
  posts.map(async (p) => {
    const image = await getImage({ src: p.src, width: 900, format: "webp" });
    return { src: image.src, alt: p.alt };
  }),
);

const container = "mx-auto w-full max-w-8xl px-6 tablet:px-8 desktop:px-12";
---

<section
  class="social-cream"
  aria-label="Redes sociales"
  data-social
  style={`background-color:${fieldBg}`}
>
  {/* Full-width rule under the isologos collage — the field starts here. Projects
      whose section needs no opening rule pass `rule={false}`. */}
  {rule && (
    <div class="social-line" style={`background-color:${rule}`} aria-hidden="true" />
  )}

  <div class="py-section">
    {/* Header */}
    <div class={container}>
    <h3 class="text-p-sm font-bold tracking-wider text-text uppercase">
      {label}
    </h3>
    <p class="mt-4 max-w-md text-p text-pretty text-muted">{body}</p>
  </div>

  {/* Cards — scroll-snap carousel below desktop, 3-col grid at desktop. */}
  <div class="mt-12 tablet:mt-16">
    <ul class="social-track" data-social-track>
      {
        optimized.map((post) => (
          <li class="social-post" data-social-post>
            <article class="flex flex-col overflow-hidden rounded-lg border border-border bg-white">
              {/* Avatar bar */}
              <div class="flex items-center px-3 py-2.5">
                <span
                  class="block h-8 w-8 rounded-full"
                  style={`background-color:${avatarColor}`}
                  aria-hidden="true"
                />
              </div>

              {/* Post image */}
              <img
                src={post.src}
                alt={post.alt}
                loading="lazy"
                class="aspect-[918/1148] w-full object-cover"
              />

              {/* Action row */}
              <div
                class="flex items-center justify-between px-3 py-3"
                style={`color:${iconColor}`}
              >
                <div class="flex items-center gap-4">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
                  </svg>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" />
                  </svg>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                  </svg>
                </div>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                </svg>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    {/* Slide indicator — carousel only (hidden once it's a grid). */}
    <div
      class="mt-6 flex justify-center gap-2 desktop:hidden"
      data-social-dots
      aria-hidden="true"
    >
      {
        optimized.map((_, i) => (
          <button
            type="button"
            class="social-dot"
            data-index={i}
            aria-label={`Ir a la publicación ${i + 1}`}
          />
        ))
      }
    </div>
  </div>
  </div>
</section>

<style>
  /* The field colour and its opening rule are per-project (see `fieldBg` / `rule`),
     so only the geometry lives here. On Gelato the cream field begins at this rule
     and continues through the collages below. */
  .social-line {
    height: 1px;
    width: 100%;
  }

  /* Carousel: a horizontal scroll-snap rail. Full-bleed so cards can peek past the
     content edge; the rail is inset to the content gutter so the first card lines
     up with the header. */
  .social-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .social-track::-webkit-scrollbar {
    display: none;
  }
  .social-post {
    flex: 0 0 82%;
    max-width: 22rem;
    scroll-snap-align: center;
  }

  .social-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: var(--color-border);
    transition:
      width 0.25s ease,
      background-color 0.25s ease;
    cursor: pointer;
  }
  .social-dot.is-active {
    width: 1.25rem;
    background-color: var(--color-primary);
  }

  /* Desktop: the rail becomes a static three-column grid. */
  @media (width >= 1024px) {
    .social-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      overflow: visible;
      padding-inline: 0;
      max-width: 88rem;
      margin-inline: auto;
      padding-inline: 3rem;
    }
    .social-post {
      flex: initial;
      max-width: none;
    }
  }
</style>

<script>
  // Progressive enhancement: light the dot for the centred card, and let dots
  // scroll the rail. Scoped per carousel so multiple can coexist.
  document.querySelectorAll<HTMLElement>("[data-social]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-social-track]");
    const dotsWrap = root.querySelector<HTMLElement>("[data-social-dots]");
    if (!track || !dotsWrap) return;
    const posts = [...track.querySelectorAll<HTMLElement>("[data-social-post]")];
    const dots = [...dotsWrap.querySelectorAll<HTMLButtonElement>(".social-dot")];

    const setActive = (i: number) =>
      dots.forEach((d, di) => d.classList.toggle("is-active", di === i));
    setActive(0);

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio >= 0.6) {
            setActive(posts.indexOf(e.target as HTMLElement));
          }
        });
      },
      { root: track, threshold: 0.6 },
    );
    posts.forEach((p) => io.observe(p));

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () =>
        posts[i].scrollIntoView({
          behavior: "smooth",
          inline: "center",
          block: "nearest",
        }),
      ),
    );
  });
</script>
