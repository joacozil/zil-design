---
/**
 * ColumnCollage — a collage of applied pieces laid out as COLUMNS, each column a
 * stack of images at their own natural ratio.
 *
 * The distinction from `Mosaic` is the axis the composition is built on, and it
 * is not cosmetic. Mosaic is row-based: a row levels itself to ONE height and
 * splits its width by weight, so two pieces sharing a row always share a bottom
 * edge. That is the wrong model for a masonry — a set where the columns line up
 * top and bottom but split at DIFFERENT points inside, because the pieces are
 * mockups shot at unrelated ratios (a tall street-sign against a wide browser
 * chrome). Feeding those to Mosaic either crops them or produces a zigzag of
 * unequal column widths.
 *
 * Here the columns are equal width and the images keep their own proportions,
 * so a column's height is whatever its stack adds up to. Two columns come out
 * flush at the bottom when their ratios happen to balance (the usual case, since
 * a collage is composed that way) and simply end where they end when they don't
 * — nothing is stretched to force it.
 *
 * Below `tablet` the columns collapse to a single stack. The bento's order is
 * spatial (which pieces share a column); a stack's is a sequence, so `stackOrder`
 * exists for the same reason it does on Mosaic — set it on EVERY item or none, as
 * an unset item sorts to the front.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Item {
  src: ImageMetadata;
  alt: string;
  /** Position in the collapsed single-column order, 1-based. */
  stackOrder?: number;
}
interface Props {
  /** One entry per column, each a top-to-bottom stack. */
  columns: Item[][];
  /** Section landmark label. */
  ariaLabel?: string;
  /**
   * Optional caption above the collage — the same small-uppercase-label-over-a-
   * muted-paragraph pattern every other captioned section on a project page
   * uses, so a reader moving down the page meets one voice. Omit both for a
   * collage that needs no introduction (Vibra's does not).
   */
  label?: string;
  body?: string;
  /**
   * Which edge the caption hangs from. `start` (the default) is the page's usual
   * voice; `end` is for a block whose composition leaves its air on the right,
   * where a left-set caption would sit in the middle of nothing.
   */
  captionAlign?: "start" | "end";
  /**
   * How columns of unequal height sit against each other.
   *
   * `start` (the default) hangs them from a shared top edge, which is right when
   * the ratios were composed to balance and the columns end flush anyway.
   *
   * `center` is for a set that deliberately does NOT balance — Merienda's feed
   * mockups are a third taller than its post cards, so the short column reads as
   * having fallen off the bottom unless the difference is split between the two
   * ends. It is the stagger, not a fallback for a column that came out wrong.
   */
  align?: "start" | "center";
  /**
   * Space between the pieces, both axes. Defaults to the shared collage token —
   * the same value and reasoning as Mosaic's — and that is what a collage of
   * flat artwork wants, where the gap only has to say where one piece ends.
   *
   * Override it for pieces that are OBJECTS rather than images: Merienda's
   * section is phone mockups, which already carry a dark frame and a shadow, so
   * at the token's 16px they read as one slab of phones rather than as nine
   * pieces laid out. Its artboard sets them about 34px apart at a desktop width.
   */
  gap?: string;
}
const {
  columns,
  ariaLabel = "Piezas del proyecto",
  label,
  body,
  captionAlign = "start",
  align = "start",
  gap,
} = Astro.props;

// The `sizes` hint has to know how many columns share the row, or a three-column
// collage asks for images at half the container and ships 1.5× the pixels it can
// show. Below the breakpoint every column is the full width, whatever the count.
const colVw = Math.round(100 / columns.length);
---

<section class="py-section" aria-label={ariaLabel}>
  <div class="mx-auto w-full max-w-8xl px-6 tablet:px-8 desktop:px-12">
    {
      label && (
        <div
          class:list={[
            "mb-12 max-w-md tablet:mb-16",
            captionAlign === "end" && "ml-auto",
          ]}
        >
          <h2 class="text-p-sm font-bold tracking-wider text-text uppercase">
            {label}
          </h2>
          {body && <p class="mt-4 text-p-sm text-muted">{body}</p>}
        </div>
      )
    }
    <div
      class:list={["cc", align === "center" && "cc--center"]}
      style={gap ? `--gap:${gap}` : undefined}
    >
      {
        columns.map((col) => (
          <div class="cc-col">
            {col.map((it) => (
              <Image
                class="cc-img"
                style={it.stackOrder ? `--order:${it.stackOrder}` : undefined}
                src={it.src}
                alt={it.alt}
                widths={[640, 960, 1280]}
                sizes={`(min-width: 640px) ${colVw}vw, 100vw`}
                loading="lazy"
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* One gap token for both axes, so the spacing reads uniform all around — the
     same value and the same reasoning as Mosaic's. */
  .cc {
    --gap: clamp(0.5rem, 1.1vw, 1rem);
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Stacked: the columns STOP EXISTING (`display: contents` lifts their images
     to be the collage's own children) so `stackOrder` can interleave pieces the
     bento keeps in different columns. Without the flatten, `order` could only
     shuffle within a column. */
  .cc-col {
    display: contents;
  }

  .cc-img {
    display: block;
    width: 100%;
    height: auto;
    order: var(--order, 0);
  }

  @media (width >= 640px) {
    .cc {
      flex-direction: row;
      align-items: flex-start;
    }
    /* Columns of unequal height centred against each other — see `align`. It is
       only ever the ROW's cross-axis alignment, so the stacked layout below the
       breakpoint, where `.cc` is a column, is untouched. */
    .cc--center {
      align-items: center;
    }
    .cc-col {
      display: flex;
      flex: 1;
      /* `min-width: 0` — without it a flex item floors at its content's
         intrinsic width, and a 2283px-wide mockup would push the column past its
         half share and overflow the container. */
      min-width: 0;
      flex-direction: column;
      gap: var(--gap);
    }
    .cc-img {
      order: 0;
    }
  }
</style>
