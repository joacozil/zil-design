---
/**
 * WebAdapt — the campaign's pieces redrawn for the brand's own site, shown on
 * the two screens they were drawn for, on a field with the burst behind them.
 *
 * One picture and one block of copy, and they are measured against DIFFERENT
 * things on purpose. The mockup is placed as a share of the section's WIDTH, so
 * it scales as one image whatever the viewport. The copy takes the page's
 * container, like every other block of text on the site — the vertical comes
 * from the picture, the horizontal from the page.
 *
 * At `desktop` the two share ONE grid cell: the row is as tall as the mockup,
 * the copy sits at its foot, and neither can push the other out of the
 * composition. Below that they simply stack, which is the only thing a column
 * narrow enough to need it can do.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** The flat field the whole section stands on. */
  field: string;
  /** The burst, laid behind the screens. */
  rays: ImageMetadata;
  /** The two screens, as one piece of artwork. */
  mockup: { src: ImageMetadata; alt: string };
  /** The copy. The label is a chip; the body sits under it. */
  label: string;
  body: string;
  /** Section landmark label. */
  ariaLabel?: string;
}
const {
  field,
  rays,
  mockup,
  label,
  body,
  ariaLabel = "Adaptación de piezas web",
} = Astro.props;

/* ── The artboard, in its own units ──────────────────────────────────────────
   page     811 wide
   mockup   x 84, 609 wide — and its top is the section's own top padding; at
            `desktop` it gives width back to the copy, see the styles
   burst    its centre 217 below the mockup's top, 431 across
   Divided through by 811 below, so the picture scales as one thing. */
---

<section
  class="wa"
  style={`--wa-field:${field};--wa-rays:url("${rays.src}")`}
  aria-label={ariaLabel}
>
  {
    /* A BACKGROUND, not an `<img>`: the artwork converges at exactly its own
      middle, so placing it is arithmetic on one point rather than a box to
      size — and a background has no intrinsic height to fight. */
  }
  <div class="wa-rays" aria-hidden="true"></div>

  <div class="wa-inner">
    <Image
      class="wa-mockup"
      src={mockup.src}
      alt={mockup.alt}
      loading="lazy"
      sizes="76vw"
    />

    <div class="wa-copy">
      <div class="wa-copy-inner">
        <h3 class="wa-label">{label}</h3>
        <p class="wa-body">{body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .wa {
    position: relative;
    container-type: inline-size;
    background-color: var(--wa-field);
    padding-block: var(--spacing-section);
    overflow: clip;
  }

  /* The burst's CENTRE goes behind the screens. The artwork converges at its
     own middle (960, 2252.5 of 1920 × 4505), and at `background-size: 100% auto`
     it is as wide as this box — so its centre sits 50cqw right of and 117.32cqw
     below wherever the image's corner is put. Putting the corner at the target
     less those two lands the convergence where the artboard has it: 53.1cqw
     across, and 26.75cqw below the mockup's top, which is the padding. */
  .wa-rays {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--wa-rays);
    background-repeat: no-repeat;
    background-size: 100% auto;
    background-position: calc(53.14cqw - 50cqw)
      calc(var(--spacing-section) + 26.75cqw - 117.32cqw);
  }

  .wa-inner {
    position: relative;
    z-index: 1;
  }

  /* In a column the picture takes the page's own measure, centred: there is no
     copy beside it to leave room for, so the artboard's inset is width thrown
     away. */
  .wa-mockup {
    display: block;
    margin-inline: auto;
    width: calc(100% - 2 * var(--gutter));
    height: auto;
  }

  /* Below `desktop` the copy follows the picture, in the page's own column. */
  .wa-copy {
    margin-inline: auto;
    margin-top: var(--spacing-section-tight);
    width: 100%;
    max-width: var(--container-8xl);
    padding-inline: 1.5rem;
  }

  .wa-label {
    display: inline-block;
    padding: 0.35em 0.7em;
    background-color: #ffffff;
    color: var(--wa-field);
    font-size: var(--text-p-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .wa-body {
    margin-top: 1rem;
    max-width: 24rem;
    color: #ffffff;
    font-size: var(--text-p-sm);
    text-wrap: pretty;
  }

  @media (min-width: 40rem) {
    .wa-copy {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 64rem) {
    /* One cell for both: the row is the mockup's height, so the copy can sit at
       its foot without either one being able to push the other out of the
       composition — and without a second measurement to keep in step. */
    .wa-inner {
      display: grid;
    }

    .wa-mockup,
    .wa-copy {
      grid-area: 1 / 1;
    }

    /* The picture pulls back so the copy has a column of its own: at the
       artboard's width the two met, and a block of text set against a
       photograph it touches reads as part of it. The mockup keeps its left
       margin small and gives up the width on the right, which is the side the
       copy is pinned to. */
    .wa-mockup {
      margin-inline: 0;
      margin-left: 6%;
      width: 58%;
    }

    .wa-copy {
      align-self: end;
      margin-top: 0;
      padding-inline: 3rem;
    }

    /* Against the container's RIGHT edge, where the artboard puts it. */
    .wa-copy-inner {
      margin-left: auto;
      width: 24rem;
    }
  }
</style>
