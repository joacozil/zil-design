---
/**
 * TypeSpecimen — the project's typeface shown big and brutalist. Shared by every
 * project; the font(s) are passed in (each project ships its own).
 *
 * Two parts:
 *   1. Specimen blocks (alphabet, numerals, symbols) top-right — either Regular /
 *      Bold of one family (default), or a custom `specimens` set for a multi-font
 *      system (Gelato: Job Clarendon + Acumin, the display face left unlabelled
 *      since the giant wordmark names it).
 *   2. The typeface name set ENORMOUS, one word per line, bleeding to the edges,
 *      split by a full-width rule — the brutalist device — or a supplied SVG.
 *
 * For the single-family path the font is loaded via a @font-face injected from the
 * passed URLs; with a custom `specimens` set the page registers the fonts. The
 * giant display is aria-hidden; an sr-only heading carries the name so assistive
 * tech isn't read the wordmark twice or the glyph rows.
 */
interface SpecimenSpec {
  /** Optional heading above the glyph rows. Omit for an unlabelled specimen. */
  label?: string;
  /** CSS font-family for this specimen (the page registers the font). */
  fontFamily: string;
  /** Weight. Default 400. */
  fontWeight?: number;
  /** Optional CSS font-size override. Purely an OPTICAL correction: the shared
      `--specimen-size` below is the size for a normal-width text face, and a
      condensed display face (Job Clarendon) needs a bump to read at the same
      weight beside one. Never set this to re-tune the specimen size in general —
      that number lives once, in the component. */
  fontSize?: string;
}
interface Props {
  /** Typeface name, e.g. "Acumin Pro". Shown huge (one word per line) and in the specimen labels. */
  name: string;
  /** CSS family name to register + apply. Usually the same as `name`. */
  fontFamily: string;
  /** Built-time URLs of the two weights (import with `?url` in the page). Omit when
      passing a custom `specimens` set whose fonts the page already registers. */
  regularUrl?: string;
  boldUrl?: string;
  /** font `format()` hint. OTF = "opentype". */
  format?: string;
  /** Optional SVG image to replace the generated wordmark. */
  wordmarkImage?: ImageMetadata;
  /** Override the default Regular/Bold pair with a custom set — e.g. a two-typeface
      system (Gelato: Job Clarendon + Acumin). The page registers these fonts. */
  specimens?: SpecimenSpec[];
}
const {
  name,
  fontFamily,
  regularUrl,
  boldUrl,
  format = "opentype",
  wordmarkImage,
  specimens,
} = Astro.props;

const words = name.split(" ");

const upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
const lower = "abcdefghijklmnopqrstuvwxyz";
const digits = "1234567890";
const symbols = "¡@#$%^&*()[]";

const fontStack = `"${fontFamily}", var(--font-sans)`;

// Default to Regular / Bold of the one passed family; a project with a multi-font
// system passes its own `specimens` instead.
const specimenList: SpecimenSpec[] = specimens ?? [
  { label: `${name} - Regular`, fontFamily: fontStack, fontWeight: 400 },
  { label: `${name} - Bold`, fontFamily: fontStack, fontWeight: 700 },
];

// Register the passed font under `fontFamily` — only when the URLs are given (the
// single-family path). With a custom `specimens` set the page owns registration.
// @font-face can't read CSS vars for its src, so URLs are interpolated here.
const fontFaceCss =
  regularUrl && boldUrl
    ? `
@font-face{font-family:"${fontFamily}";src:url("${regularUrl}") format("${format}");font-weight:400;font-style:normal;font-display:swap;}
@font-face{font-family:"${fontFamily}";src:url("${boldUrl}") format("${format}");font-weight:700;font-style:normal;font-display:swap;}
`
    : "";
---

{fontFaceCss && <style is:global set:html={fontFaceCss} />}

<section class="border-t border-border py-section" aria-label="Tipografía">
  <h2 class="sr-only">Tipografía: {name}</h2>

  {/* Specimens — one block per weight (Clojure) or per typeface (Gelato's two-font
      system). Stacked until DESKTOP, then a right-aligned row. Each block sets its
      own family + weight; an unlabelled block (the display face, named by the giant
      wordmark below) starts straight at the glyph rows.

      The row waits for desktop because two alphabets side by side need ~715px plus
      gutters and simply do not fit a 640px tablet: with `justify-end` the surplus
      runs off the LEFT edge, which produces no scrollbar, so the first specimen was
      silently clipped rather than visibly broken. Stacking is what fits.

      The spacing inside a block is deliberately much tighter than the gap between
      blocks (12px vs 64px): a specimen is a SET of rows that belong to one face, and
      when the two spacings were close the stacked layout read as eight loose lines
      rather than two specimens. Snug leading serves the same end — glyph rows are
      reference material to scan, not prose to read, so generous leading only pulled
      the set apart. */}
  <div class="mx-auto w-full max-w-8xl px-6 tablet:px-8 desktop:px-12">
    <div
      class="flex flex-col gap-16 desktop:flex-row desktop:justify-end"
    >
      {
        specimenList.map((s) => (
          <div
            class="specimen text-text"
            style={`font-family:${s.fontFamily};font-weight:${s.fontWeight ?? 400}${s.fontSize ? `;font-size:${s.fontSize}` : ""}`}
          >
            {s.label && <p class="mb-3">{s.label}</p>}
            <p class="leading-snug">
              {upper}
              <br />
              {lower}
            </p>
            <p class="mt-3 leading-snug">
              {digits}
              <br />
              {symbols}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  {/* Giant wordmark — full-bleed display of the typeface name. When the project
      supplies a pre-made SVG (`wordmarkImage`), it renders as a full-width image.
      Otherwise falls back to the generated one-word-per-line layout. */}
  {wordmarkImage ? (
    <img
      src={wordmarkImage.src}
      width={wordmarkImage.width}
      height={wordmarkImage.height}
      alt=""
      aria-hidden="true"
      class="mt-16 w-full tablet:mt-24"
    />
  ) : (
    <div
      class="type-box mt-16 border-t border-border tablet:mt-24"
      aria-hidden="true"
    >
      {
        words.map((word) => (
          <div class="border-b border-border pl-[var(--gutter)]">
            <span
              class="type-display block text-text"
              style={`font-family:${fontStack}`}
            >
              {word}
            </span>
          </div>
        ))
      }
    </div>
  )}
</section>

<style>
  /* THE specimen size, for every project. A specimen is a sample of a typeface —
     it has to be big enough to read the shapes, which is a different job from
     body copy, so it is NOT on the `text-p-*` scale and does not step at the
     breakpoints. Tuned on Gelato and adopted by the rest; set it here, never at
     a call site.

     The cap: a glyph row is ONE unbreakable-in-spirit string (a wrapped alphabet
     stops being a specimen), so the size is also bounded by the width available
     to it. 26 uppercase letters measure 17.64em in the widest face any project
     ships (Ubuntu Bold; Acumin Bold is 17.43), so `/18` is that worst case with a
     little margin, and `100vw - 3rem` is the mobile gutter. The cap only bites
     below ~380px — every phone from an iPhone 14 up gets the full 1.15rem. A
     project adding a wider face than Ubuntu Bold is the one thing that would need
     this number re-measured. */
  .specimen {
    font-size: min(1.15rem, calc((100vw - 3rem) / 18));
  }

  .type-display {
    font-size: clamp(4rem, 26vw, 26rem);
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.03em;
    /* Each word hugs its own bottom rule: a small breathing gap above the caps and
       a tight gap from the baseline to the rule below. In `em` of the display, so
       they scale cleanly through the whole clamp. Tuned for Acumin Pro's metrics —
       a different project font may want a small retune. */
    padding-top: 0.17em;
    padding-bottom: 0.05em;
  }
</style>
