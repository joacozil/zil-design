---
/**
 * ConceptCircles — the words that stand for a project, set in a chain of
 * interconnected rings. Shared by every project; the words and their look (ring
 * stroke, word colour, font, weight) are passed in, so the SAME chain reads as
 * white sans on Clojure's navy and light Job Clarendon on Gelato's cream.
 *
 * The rings overlap so adjacent outlines cross (a Venn-style chain). They carry
 * no fill, so the overlaps never hide a neighbour's label. The chain runs
 * vertically on mobile (where five side-by-side rings would crush the text) and
 * horizontally at tablet+. Overlap is a negative margin on every ring but the
 * first, flipped from block-start to inline-start at the breakpoint.
 *
 * The diameter is FLUID at every size, but for a different reason at each:
 *
 * - Mobile (vertical chain): the diameter is derived from the VIEWPORT HEIGHT so
 *   all five rings sit on one screen without scrolling — as big as they can be
 *   while still all fitting. The rings overlap by `d/8` (shallow, so they stay
 *   interconnected but a little apart): the chain's height is `5·d − 4·(d/8)` =
 *   `4.5·d` (five rings minus four d/8 overlaps), so the ring that fits the
 *   viewport is `(100svh − section padding) / 4.5`, capped so it never balloons
 *   on a tall phone. A shallower overlap shrinks every ring to keep the five on
 *   screen — this is the trade against ring size.
 * - Tablet+ (horizontal chain): the diameter is `clamp(8rem, 20vw, 19rem)` so the
 *   chain grows with the viewport (big on wide desktops, per the design) yet five
 *   rings always fit the row down to 640px without overflow.
 *
 * Overlap is `d/8` on the leading edge on mobile and a gentler fixed inset at
 * tablet+ where width, not height, is the budget.
 *
 * The ring OUTLINE is neither sized nor coloured here: both come from the
 * project's LogoGrid artwork, so the two sections draw the literal same line —
 * its weight from `gridWidth`, its colour from `stroke`.
 */
interface Props {
  words: string[];
  /**
   * Ring outline colour (any CSS colour). Required, and it should be the colour
   * the project's LogoGrid artwork strokes ITS rules in — `#ADDD52` for Clojure,
   * `#896451` for Gelato, `#124734` for Quantia. Together with the weight derived
   * from `gridWidth`, that makes the two sections draw the literal same line.
   *
   * Not a faded tint of the brand colour: the rings used to be strokes like
   * `rgb(18 71 52 / 0.35)`, which read lighter than the grid they sit beside.
   * The hairline is already faint from its sub-pixel WIDTH — see --ring-bw.
   */
  stroke: string;
  /** Word colour. Default: inherit the section's text colour. */
  ink?: string;
  /** CSS font-family for the words. Default: the site sans. */
  fontFamily?: string;
  /** Word font-weight. Default: 500 (medium). */
  fontWeight?: number;
  /**
   * Word size as a fraction of the ring diameter. A FRACTION, never a length: the
   * ring is fluid at every breakpoint, and only a ratio keeps the word sitting in
   * the circle the same way on a phone and on a wide desktop.
   *
   * The default is calibrated so the longest word of a normal-width sans fills a
   * little over half the diameter — measured against Gelato, whose longest word
   * (EXCLUSIVIDAD) sits at 0.52·d and is the look every project wants. Override it
   * only for a face whose width per character is unusual: Gelato passes 0.12
   * because Job Clarendon is condensed, so it needs a much bigger size to reach
   * the same width.
   *
   * Raising this is bounded by the OVERLAP, not by the ring: adjacent rings cross
   * 1.4vw into each other at tablet+, so a word wider than ~0.8·d would run into a
   * neighbour's outline before it ever touched its own.
   */
  fontScale?: number;
  /**
   * Intrinsic width, in its own units, of the project's LogoGrid artwork —
   * i.e. `gridImage.width`. It exists so the ring outline can be drawn at the
   * SAME weight as that artwork's rules; see `--ring-bw` in the style block.
   */
  gridWidth: number;
}
const {
  words,
  stroke,
  ink,
  fontFamily,
  fontWeight = 500,
  fontScale = 0.085,
  gridWidth,
} = Astro.props;

// Ring outline weight, expressed as a fraction of the LogoGrid's DISPLAY width.
//
// Every project's grid artwork draws its rules at `stroke-width="0.5"` in the
// SVG's own units, and the <img> scales the whole drawing to fit, so the weight
// the reader actually sees is `0.5 · displayWidth / intrinsicWidth` — a value
// that shrinks with the viewport. The rings sat at a flat 1px (0.5px at 2dppx),
// so the two matched only at the width where the grid stops growing: below that,
// the rings read as the heavier line. Multiplying the grid's display width by
// this factor reproduces its stroke exactly, at every size.
//
// It is a FACTOR rather than a length because the display width is a CSS `min()`
// that only the browser can resolve (see --grid-w) — the division is done here,
// in numbers, so the stylesheet is left with a plain multiplication.
const ringBorderFactor = 0.5 / gridWidth;

// The word's look is per-project (a display face for Gelato, the site sans for
// Clojure), so it's authored inline from the props rather than baked into a class.
// The size is always derived from the ring diameter (--ring-d) — there is no
// fixed-size path, because a fixed size in a fluid ring means a word that fills
// the circle at one width and rattles around in it at another.
//
// The `max()` is a legibility floor, and it is the reason this is not a plain
// ratio: at the tablet breakpoint the ring bottoms out around 128px, where the
// ratio alone would set the word at ~11px. 0.875rem is the size these labels have
// always been, so the floor changes nothing below ~825px viewport and simply lets
// the word grow with the ring above it — which is the whole point.
const labelStyle = [
  ink && `color:${ink}`,
  fontFamily && `font-family:${fontFamily}`,
  `font-weight:${fontWeight}`,
  `font-size:max(0.875rem, calc(var(--ring-d) * ${fontScale}))`,
]
  .filter(Boolean)
  .join(";");
---

<section
  class="concept-circles py-section"
  style={`--ring-bw-factor:${ringBorderFactor}`}
>
  <div
    class="mx-auto flex w-full max-w-8xl flex-col items-center px-6 tablet:flex-row tablet:justify-center tablet:px-8 desktop:px-12"
  >
    {
      words.map((word) => (
        <div class="concept-ring relative flex aspect-square shrink-0 items-center justify-center">
          <svg class="concept-ring-outline" aria-hidden="true" focusable="false">
            <circle fill="none" stroke={stroke} />
          </svg>
          <span class="relative tracking-wider uppercase" style={labelStyle}>
            {word}
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Mobile: size the ring to the viewport height so the whole five-ring chain
     fits on one screen. `11rem` is the section's own top+bottom padding
     (py-section = 5rem each) plus ~1rem of breathing room; `4.5` is the chain's
     height in ring-diameters — `5·d − 4·(d/8)` for the shallow `d/8` overlap
     below. `svh` (not `vh`) so the fit holds even while the mobile browser chrome
     is expanded. */
  .concept-circles {
    --ring-d: clamp(6rem, calc((100svh - 11rem) / 4.5), 18rem);
  }

  /* --grid-w mirrors, in CSS, the width the LogoGrid <img> resolves to on this
     same page: `w-full max-w-3xl` (48rem) inside the standard container, whose
     side padding steps 1.5rem → 2rem → 3rem. That makes the image
     `min(48rem, 100cqw − 2 × padding)`.

     Only the first two steps are written out, because the desktop one would be
     dead code: 100cqw − 4rem already exceeds 48rem from 832px up, so the tablet
     expression is pinned at 48rem long before the 1024px breakpoint — where the
     desktop padding would first apply. Both branches therefore agree above
     832px, and the ring stops changing exactly where the grid does.

     `cqw` — hence `container-type` on this section — and NOT `vw`, which is off
     by the scrollbar: `vw` includes it, the container's own `%` width does not.
     That put the ring 2% heavy than the grid at 768px on a classic scrollbar.
     The obvious `--gutter` token is no use here either: it is `%`-based, and a
     percentage survives var() substitution unresolved, so `stroke-width` would
     resolve it against the SVG viewport DIAGONAL rather than a width.

     The section is full-width, so `100cqw` is exactly the basis the container's
     `%` padding resolves against — the two agree with or without a scrollbar.
     Note this makes --grid-w usable only in DESCENDANTS: an element never
     queries itself, and .concept-circles is the container. */
  .concept-circles {
    container-type: inline-size;
    --grid-w: min(48rem, calc(100cqw - 3rem));
    /* The grid artwork's own stroke, reproduced. Deliberately sub-pixel at small
       sizes, because so is the line it is matching. */
    --ring-bw: calc(var(--grid-w) * var(--ring-bw-factor));
  }

  /* `concept-ring`, never `ring`: `ring` is a Tailwind utility that paints a
     box-shadow outline in currentColor. The old markup collided with it and got
     away with it only because `rounded-full` bent that shadow into a circle
     sitting under the real border. Drop the rounding — as the SVG outline does —
     and it reappears as a hard black RECTANGLE around every word. */
  .concept-ring {
    width: var(--ring-d);
  }

  /* The outline is an SVG stroke and NOT a CSS border, which is the whole reason
     this markup carries an <svg> at all. A border snaps to whole device pixels:
     Chrome floors it at one, so on a 2x screen it can never render finer than
     0.5px — while the grid's own rules sit near 0.22px on a phone. The ring would
     read as the heavier line at exactly the sizes this is meant to fix. An SVG
     stroke is anti-aliased instead, so it thins out below a pixel the same way
     the grid <img> does, and the two match by construction.

     No viewBox, deliberately: without one, an SVG user unit IS a CSS pixel, so
     `stroke-width` can be handed --ring-bw directly. Give it a viewBox and the
     value would be rescaled by the ring's diameter — which grows on a different
     curve from the grid — and the match would hold at exactly one size. */
  .concept-ring-outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .concept-ring-outline circle {
    cx: 50%;
    cy: 50%;
    /* Pulled in by half the stroke so its OUTER edge lands on the box edge, which
       is where the old border painted. Keeps the chain's overlap geometry — set
       in ring diameters below — measuring the same circle it always did. */
    r: calc(50% - var(--ring-bw) / 2);
    stroke-width: var(--ring-bw);
  }
  /* Every ring but the first pulls back onto its predecessor — a shallow lens so
     they stay interconnected but sit a little apart. */
  .concept-ring + .concept-ring {
    margin-top: calc(var(--ring-d) / -8);
  }

  @media (width >= 640px) {
    .concept-circles {
      --ring-d: clamp(8rem, 20vw, 19rem);
      /* The container's padding steps to 2rem here; --grid-w follows it. */
      --grid-w: min(48rem, calc(100cqw - 4rem));
    }
    .concept-ring + .concept-ring {
      margin-top: 0;
      margin-left: -1.4vw;
    }
  }
</style>
