---
/**
 * Mosaic — a full-bleed bento of images laid out as weighted ROWS, each row a
 * weighted set of images. Shared by every project; the rows are passed in.
 *
 * Desktop: the whole mosaic carries an aspect-ratio, rows split its height by
 * their `weight`, and images split each row's width by theirs — so every image
 * `object-cover`s a cell sized to its share. Weights are applied via a CSS custom
 * property (not inline `flex`) so the mobile layout can ignore them and stack
 * each image at its natural ratio instead of collapsing to a zero-basis flex box.
 *
 * The gap between images and the side inset are driven by one token, so the
 * spacing reads uniform all around (matching the sibling collage).
 */
import type { ImageMetadata } from "astro";

interface Item {
  src: ImageMetadata;
  alt: string;
  /** Share of the row's width on desktop. */
  weight?: number;
}
interface RowDef {
  items: Item[];
  /** Share of the mosaic's height on desktop. */
  weight?: number;
}
interface Props {
  rows: RowDef[];
  /** Desktop aspect-ratio of the whole mosaic, e.g. "1600 / 850". */
  aspect?: string;
  /** Section landmark label. */
  ariaLabel?: string;
  /**
   * Side inset. Defaults to the gap, so the mosaic reads full-bleed and the
   * spacing is uniform all around. Pass `var(--gutter)` for a mosaic that starts
   * on the content edge instead — the design-system full-bleed rule.
   */
  inset?: string;
  /**
   * Breakpoint the weighted bento takes over at. Below it, images stack full
   * width at their natural ratio.
   *
   * Defaults to `desktop`, which is right for a mosaic of many small cells (a
   * row of five event flyers is unreadable at 240px each). Pass `tablet` for a
   * mosaic of few, large pieces whose rows are already cut to a common height —
   * there, stacking is the worse layout, since it turns three rows into seven
   * full-width blocks and the section stops reading as a composition.
   */
  rowsFrom?: "tablet" | "desktop";
  /**
   * How an image meets its cell.
   *
   * `cover` (default) sizes the whole bento to `aspect` and crops each image to
   * the cell that falls out of the weights — right when the pieces are flat
   * artwork whose edges don't matter.
   *
   * `natural` throws the container aspect away and lets each row level itself:
   * widths stay proportional to the weights and the row's height is whatever the
   * images' own ratio makes it, so NOTHING is cropped. Use it for photographed
   * mockups, where cropping eats the margin the shot was composed with and the
   * piece reads as zoomed in. It also makes `aspect` unnecessary — the bento's
   * proportion is the sum of what the rows resolve to.
   */
  fit?: "cover" | "natural";
}
const {
  rows,
  aspect = "1600 / 850",
  ariaLabel = "Piezas del evento",
  inset,
  rowsFrom = "desktop",
  fit = "cover",
} = Astro.props;
---

<section aria-label={ariaLabel} class="py-section">
  {
    /* The inset lives on a WRAPPER, not on `.mosaic` itself. `aspect-ratio` sizes
      the BORDER box, so padding on the same element makes the bento taller than
      the width its images actually get — every cell then comes out too tall and
      `object-cover` crops the sides. Splitting the two keeps the ratio honest at
      any inset. */
  }
  <div class="mosaic-outer" style={inset ? `--inset:${inset}` : undefined}>
    <div
      class:list={[
        "mosaic",
        rowsFrom === "tablet" && "mosaic--from-tablet",
        fit === "natural" && "mosaic--natural",
      ]}
      style={`--aspect:${aspect}`}
    >
      {
        rows.map((row) => (
          <div class="mosaic-row" style={`--w:${row.weight ?? 1}`}>
            {row.items.map((it) => (
              <img
                class="mosaic-img"
                style={`--w:${it.weight ?? 1}`}
                src={it.src.src}
                width={it.src.width}
                height={it.src.height}
                alt={it.alt}
                loading="lazy"
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mosaic-outer {
    --gap: clamp(0.5rem, 1.1vw, 1rem);
    padding-inline: var(--inset, var(--gap));
  }

  .mosaic {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .mosaic-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Mobile: each image full width at its natural ratio (weights ignored). */
  .mosaic-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  /* The bento. Duplicated rather than factored out because the two variants
     differ ONLY in the breakpoint they start at, and a media query can't take a
     variable — see `rowsFrom`. */
  @media (width >= 640px) {
    .mosaic--from-tablet {
      aspect-ratio: var(--aspect);
    }
    .mosaic--from-tablet .mosaic-row {
      flex-direction: row;
      flex: var(--w);
      min-height: 0;
    }
    .mosaic--from-tablet .mosaic-img {
      flex: var(--w);
      width: auto;
      height: 100%;
      min-width: 0;
      min-height: 0;
    }
  }

  /* `natural`: the row levels itself. Each image's flex-grow is its weight
     against a zero basis, so widths come out proportional and the height is the
     one the images' own ratio produces — gaps included, since flex takes them
     out of the space it distributes. No container ratio, so no crop. */
  @media (width >= 640px) {
    .mosaic--natural.mosaic--from-tablet,
    .mosaic--natural.mosaic--from-tablet .mosaic-row {
      aspect-ratio: auto;
      flex: none;
    }
    .mosaic--natural.mosaic--from-tablet .mosaic-row {
      flex-direction: row;
      align-items: flex-start;
    }
    .mosaic--natural.mosaic--from-tablet .mosaic-img {
      flex: var(--w) 1 0;
      width: 0;
      height: auto;
    }
  }

  @media (width >= 1024px) {
    .mosaic {
      aspect-ratio: var(--aspect);
    }
    .mosaic-row {
      flex-direction: row;
      flex: var(--w);
      min-height: 0;
    }
    .mosaic-img {
      flex: var(--w);
      width: auto;
      height: 100%;
      min-width: 0;
      min-height: 0;
    }

    .mosaic--natural,
    .mosaic--natural .mosaic-row {
      aspect-ratio: auto;
      flex: none;
    }
    .mosaic--natural .mosaic-row {
      flex-direction: row;
      align-items: flex-start;
    }
    .mosaic--natural .mosaic-img {
      flex: var(--w) 1 0;
      width: 0;
      height: auto;
    }
  }
</style>
