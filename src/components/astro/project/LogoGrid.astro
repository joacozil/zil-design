---
/**
 * LogoGrid — the project's brand lockup shown inside its compositional grid.
 * Shared by every project; the artwork is a self-contained SVG (logo + grid +
 * accent blocks) supplied per project, centred on the section field.
 */
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}
const { image, alt } = Astro.props;
---

<section class="py-section">
  <div
    class="mx-auto flex w-full max-w-8xl justify-center px-6 tablet:px-8 desktop:px-12"
  >
    {/* Natural width, capped — NOT `w-full`. Every project's grid artwork is drawn
      about 450 units tall, so letting each one render at its own width keeps them
      all landing at a consistent HEIGHT on the page (Clojure 449, Gelato 404,
      Quantia 399, Net Value 450). `w-full` instead forced every drawing to 768
      wide, which is fine for the wide ones but blew the near-square Net Value
      grid up to 746 tall — half again the size of the others. The cap is
      `min(48rem, 100%)`: 48rem is the old max-w-3xl, and the 100% keeps it inside
      the gutter on a phone. */}
  <img
    src={image.src}
    alt={alt}
    class="h-auto w-auto max-w-[min(48rem,100%)]"
  />
  </div>
</section>
