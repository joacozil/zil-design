---
/**
 * PhotoMosaic — the campaign's photography, laid out as the board lays it out:
 * three columns of unequal width, each broken differently, so no two tiles in
 * a row share an edge pattern and the set reads as a shoot rather than as a
 * grid of thumbnails.
 *
 * The whole mosaic carries ONE aspect ratio and every track inside it is an
 * `fr`, so the composition scales as a single picture — the tiles keep their
 * relative sizes at any width, and there is no breakpoint where a tile is
 * suddenly a square. The photographs are `cover`ed into their cells, so the
 * crop is the cell's, which is the one thing a tile's own ratio could never
 * give.
 *
 * The slots are NAMED rather than numbered. The arrangement is the piece: a
 * nine-item array would place a portrait in the landscape slot the first time
 * anyone reordered the list, and nothing would say why it looked wrong.
 *
 * Below `desktop` the mosaic is abandoned, not shrunk. Its narrowest tile is a
 * twelfth of the measure: at a phone's width that is a 39-pixel photograph.
 * The set becomes two columns of portraits instead — every photograph legible,
 * in the same order.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Tile {
  src: ImageMetadata;
  alt: string;
  /** Where the photograph is anchored while it is cover-fitted to its cell. */
  position?: string;
  /**
   * `contain` for a CUT-OUT rather than a photograph: an object on
   * transparency has no spare edge to give up, so cropping it to the cell's
   * proportion takes the object itself. Fitted whole, the field shows around
   * it, which is where it was drawn to sit anyway.
   */
  fit?: "cover" | "contain";
}

interface Props {
  /**
   * The two bands that carry two tiles, as `[first, second]` widths in the
   * artboard's own units. They are props because the SPLIT is where one
   * mosaic differs from another: the arrangement is the piece, but which of
   * the pair is the wide one is the art direction of a particular set.
   */
  leftSplit?: [number, number];
  centreSplit?: [number, number];
  /**
   * Render WITHOUT the section wrapper, for a mosaic that belongs to the
   * section above it — on its field, inside its rhythm — rather than opening
   * one of its own.
   */
  bare?: boolean;
  /** Left column, top band — a landscape. */
  wideTop: Tile;
  /** Left column, middle band — the narrow portrait that opens it. */
  narrow: Tile;
  /** Left column, middle band — the wider tile beside it. */
  pair: Tile;
  /** Left column, foot — a landscape. */
  wideFoot: Tile;
  /** Centre column, top two bands — the tall one the mosaic is built around. */
  tall: Tile;
  /** Centre column, foot — left half. */
  footLeft: Tile;
  /** Centre column, foot — right half. */
  footRight: Tile;
  /** Right column, top band — a landscape. */
  corner: Tile;
  /** Right column, lower two bands — a tall portrait. */
  column: Tile;
}

const Wrapper = Astro.props.bare ? "div" : "section";

/* One place to compose a tile's crop, so nine call sites cannot drift. */
const tileStyle = (t: Tile) =>
  [
    t.position && `object-position:${t.position}`,
    t.fit === "contain" && "object-fit:contain",
  ]
    .filter(Boolean)
    .join(";") || undefined;

const {
  leftSplit = [76, 130],
  centreSplit = [105, 82],
  bare = false,
  wideTop,
  narrow,
  pair,
  wideFoot,
  tall,
  footLeft,
  footRight,
  corner,
  column,
} = Astro.props;

---

<Wrapper class:list={[bare ? "pm-bare" : "py-section"]} aria-label="Galería">
  <div class="mx-auto w-full max-w-8xl px-6 tablet:px-8 desktop:px-12">
    {
      /* ── The artboard (641 × 450) ──────────────────────────────────────────
        columns   214 / 196 / 213     rows   145 / 140 / 147     gap 10
        left column's middle band splits  76 / 130
        centre column's foot splits      105 / 82                              */
    }
    <div
      class="pm"
      style={`--pm-left:${leftSplit[0]}fr ${leftSplit[1]}fr;--pm-centre:${centreSplit[0]}fr ${centreSplit[1]}fr`}
    >
      <div class="pm-cell pm-wide-top">
        <Image
          src={wideTop.src}
          alt={wideTop.alt}
          sizes="(min-width: 1024px) 33vw, 50vw"
          style={tileStyle(wideTop)}
        />
      </div>

      {/* The left column's middle band — two tiles of its own. */}
      <div class="pm-split pm-left-mid">
        <div class="pm-cell">
          <Image
            src={narrow.src}
            alt={narrow.alt}
            sizes="(min-width: 1024px) 12vw, 50vw"
            style={tileStyle(narrow)}
          />
        </div>
        <div class="pm-cell">
          <Image
            src={pair.src}
            alt={pair.alt}
            sizes="(min-width: 1024px) 20vw, 50vw"
            style={tileStyle(pair)}
          />
        </div>
      </div>

      <div class="pm-cell pm-wide-foot">
        <Image
          src={wideFoot.src}
          alt={wideFoot.alt}
          sizes="(min-width: 1024px) 33vw, 50vw"
          style={tileStyle(wideFoot)}
        />
      </div>

      <div class="pm-cell pm-tall">
        <Image
          src={tall.src}
          alt={tall.alt}
          sizes="(min-width: 1024px) 30vw, 50vw"
          style={tileStyle(tall)}
        />
      </div>

      {/* The centre column's foot — two tiles of its own. */}
      <div class="pm-split pm-centre-foot">
        <div class="pm-cell">
          <Image
            src={footLeft.src}
            alt={footLeft.alt}
            sizes="(min-width: 1024px) 16vw, 50vw"
            style={tileStyle(footLeft)}
          />
        </div>
        <div class="pm-cell">
          <Image
            src={footRight.src}
            alt={footRight.alt}
            sizes="(min-width: 1024px) 13vw, 50vw"
            style={tileStyle(footRight)}
          />
        </div>
      </div>

      <div class="pm-cell pm-corner">
        <Image
          src={corner.src}
          alt={corner.alt}
          sizes="(min-width: 1024px) 33vw, 50vw"
          style={tileStyle(corner)}
        />
      </div>

      <div class="pm-cell pm-column">
        <Image
          src={column.src}
          alt={column.alt}
          sizes="(min-width: 1024px) 33vw, 50vw"
          style={tileStyle(column)}
        />
      </div>
    </div>

  </div>
</Wrapper>

<style>
  /* A mosaic that belongs to the section above keeps that section's rhythm:
     a step off the band before it, and nothing at the foot — the section's own
     padding closes it. */
  .pm-bare {
    margin-top: clamp(2.5rem, 9vw, 9rem);
  }

  /* Every tile is the same thing: a box that crops its photograph. */
  .pm-cell {
    position: relative;
    overflow: hidden;
  }
  .pm-cell :global(img) {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* ── Below desktop: a composition of its own ───────────────────────────
     NOT the mosaic shrunk, and not nine equal portraits either. A grid of one
     repeated tile turns a collage into a contact sheet: what the artboard is
     saying — that these photographs are not peers, that some carry the page
     and others punctuate it — is said entirely by the tiles' sizes, and a
     uniform grid throws all of it away. So the set is re-composed for the
     column: a landscape across the measure, then pairs, alternating, which is
     how every other gallery on the site meets a phone.

     It runs nearly edge to edge. At 375px a 24px margin either side costs an
     eighth of the picture; what is left around the outside is the same
     distance that separates two tiles, so the block reads as one picture with
     even air all round. */
  .pm {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      "wtop wtop"
      "narrow pair"
      "tall column"
      "wfoot wfoot"
      "fleft fright"
      "corner corner";
    /* Each row is the height its own tiles ask for — a landscape row is
       shallower than a row of portraits — and the sum of them is the ratio
       below, so the whole block scales as one picture. */
    grid-template-rows: 0.667fr 0.615fr 0.7fr 0.69fr 0.615fr 0.625fr;
    aspect-ratio: 1 / 3.912;
    column-gap: var(--pm-gap);
    /* The same DISTANCE as the column gap, restated against the height: a
       percentage row gap resolves against the block size, and on a block four
       times taller than it is wide that would draw a gap four times too big. */
    row-gap: calc(var(--pm-gap) / 3.912);
    margin-inline: calc(var(--pm-gap) - var(--gutter));
    --pm-gap: 1.56%;
  }
  /* The two bands that hold two tiles stop being boxes here and hand their
     tiles straight to the grid above, so the nine photographs are nine cells
     in one order — no second copy of the markup, and nothing loaded twice. */
  .pm-split {
    display: contents;
  }

  .pm-wide-top {
    grid-area: wtop;
  }
  .pm-left-mid {
    grid-area: auto;
  }
  .pm-left-mid > :first-child {
    grid-area: narrow;
  }
  .pm-left-mid > :last-child {
    grid-area: pair;
  }
  .pm-wide-foot {
    grid-area: wfoot;
  }
  .pm-tall {
    grid-area: tall;
  }
  .pm-centre-foot > :first-child {
    grid-area: fleft;
  }
  .pm-centre-foot > :last-child {
    grid-area: fright;
  }
  .pm-corner {
    grid-area: corner;
  }
  .pm-column {
    grid-area: column;
  }

  /* ── Desktop: the mosaic ───────────────────────────────────────────────── */
  /* The artboard's mosaic waits for `desktop`, not `tablet`: its narrowest
     tile is a twelfth of the measure, which at 768 is a 60px photograph. */
  @media (width >= 1024px) {
    .pm {
      display: grid;
      aspect-ratio: 641 / 450;
      grid-template-columns: 214fr 196fr 213fr;
      grid-template-rows: 145fr 140fr 147fr;
      /* The column composition hands everything back — a named area left
         standing against a template that no longer declares it is an invalid
         placement, and the cell falls into the implicit grid. */
      grid-template-areas: none;
      gap: 1.56%;
      row-gap: 1.56%;
      margin-inline: 0;
    }
    /* The column composition named these cells; here they are placed by their
       own nested grid again. The selector has to MATCH the specificity of the
       rules that named them (`.pm-left-mid > :first-child`), or a named area
       the desktop template no longer declares survives, the placement is
       invalid, and the tile falls out of the mosaic into an implicit row. */
    .pm-split > :first-child,
    .pm-split > :last-child {
      grid-area: auto;
    }

    /* Named placement, so the markup's order is the reading order and the
       layout stays legible beside the artboard's numbers above. */
    .pm-wide-top {
      grid-area: 1 / 1;
    }
    .pm-left-mid {
      grid-area: 2 / 1;
    }
    .pm-wide-foot {
      grid-area: 3 / 1;
    }
    .pm-tall {
      grid-area: 1 / 2 / span 2 / span 1;
    }
    .pm-centre-foot {
      grid-area: 3 / 2;
    }
    .pm-corner {
      grid-area: 1 / 3;
    }
    .pm-column {
      grid-area: 2 / 3 / span 2 / span 1;
    }

    /* The two bands that carry two tiles. Their splits are their own, and
       deliberately do not line up with any other column's — that mismatch is
       what keeps the mosaic from reading as a table. */
    .pm-split {
      display: grid;
      gap: 3.74%;
    }
    .pm-left-mid {
      grid-template-columns: var(--pm-left);
    }
    .pm-centre-foot {
      grid-template-columns: var(--pm-centre);
    }
  }
</style>
