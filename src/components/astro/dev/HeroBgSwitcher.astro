---
/**
 * TEMPORARY dev-only tool for choosing the hero background.
 *
 * Renders a small control that swaps the `src` of the hero's existing
 * `[data-hero-image]` element. It deliberately does NOT add a second <img> or
 * its own stacking context: the real image keeps its scrims, its object-cover
 * and its settle-scale intro from reveal.ts, so what you judge is the actual
 * hero, not a mockup of it.
 *
 * The choice survives a reload via localStorage, and the applying script runs
 * inline right where it is rendered so the swap happens before the reveal
 * intro, not after a visible flash of the default.
 *
 * Delete this component and its <HeroBgSwitcher> call in Hero.astro once a
 * background is picked.
 */
interface Option {
  label: string;
  src: string;
}

interface Props {
  options: Option[];
}

const { options } = Astro.props;
---

<div
  id="hero-bg-switcher"
  data-options={JSON.stringify(options)}
  class="fixed bottom-4 left-4 z-[9999] flex max-w-[calc(100vw-2rem)] flex-wrap items-center gap-1 rounded-lg border border-white/20 bg-black/80 p-2 font-mono text-[11px] text-white backdrop-blur"
>
  <span class="px-1 opacity-60">hero bg</span>
  {
    options.map((opt, i) => (
      <button
        type="button"
        data-index={i}
        class="rounded px-2 py-1 transition-colors hover:bg-white/20"
      >
        {i + 1}. {opt.label}
      </button>
    ))
  }
  <span class="px-1 opacity-40">← →</span>
</div>

<script>
  // Runs inline at render position, i.e. before the reveal intro fires.
  const panel = document.getElementById("hero-bg-switcher");
  const img = document.querySelector<HTMLImageElement>("[data-hero-image]");

  if (panel && img) {
    const options: { label: string; src: string }[] = JSON.parse(
      panel.dataset.options ?? "[]",
    );
    const KEY = "hero-bg-choice";

    const paint = (i: number) => {
      const opt = options[i];
      if (!opt) return;
      img.src = opt.src;
      // The hero <img> carries explicit width/height for the default asset; the
      // candidates have their own dimensions, so drop the attributes and let
      // object-cover do the work rather than fight a wrong aspect hint.
      img.removeAttribute("width");
      img.removeAttribute("height");
      localStorage.setItem(KEY, String(i));
      panel.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
        const on = Number(b.dataset.index) === i;
        b.classList.toggle("bg-white", on);
        b.classList.toggle("text-black", on);
      });
    };

    let current = Number(localStorage.getItem(KEY) ?? 0);
    if (!Number.isInteger(current) || !options[current]) current = 0;
    paint(current);

    panel.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "button",
      );
      if (!btn) return;
      current = Number(btn.dataset.index);
      paint(current);
    });

    window.addEventListener("keydown", (e) => {
      // Ignore while typing in the contact form.
      const t = e.target as HTMLElement;
      if (t.matches?.("input, textarea, select")) return;
      if (e.key === "ArrowRight") current = (current + 1) % options.length;
      else if (e.key === "ArrowLeft")
        current = (current - 1 + options.length) % options.length;
      else return;
      e.preventDefault();
      paint(current);
    });
  }
</script>
