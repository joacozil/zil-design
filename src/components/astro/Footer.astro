---
import { NAV_LINKS } from "../../config/nav";
import Button from "./Button.astro";
// The monochrome cut of the wordmark, inlined as a component so its fill comes
// from `currentColor` and the colour is set by the token class below. Same
// violet as the Header today, but this one sits on `primary-dark` rather than
// `surface`, so it is the one likely to be retuned: recolouring is a one-word
// change to that class instead of a new SVG file per shade, which is what the
// colour rule in CLAUDE.md asks for.
import Logo from "../../assets/img/zil-design-logo-mono.svg";

// Same path-awareness as the Header, deriving the prefix the same way: the
// section anchors only resolve on the homepage, so off-home (project pages) the
// nav links point back at the homepage to reach the matching section. The `/design`
// base is part of that prefix — a bare `/#work` would leave this site entirely.
// Off-home, "Ir Arriba" scrolls to the top of the current page instead.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isHome = Astro.url.pathname.replace(/\/$/, "") === base;
const prefix = isHome ? "" : `${base}/`;
---

<footer class="bg-primary-dark text-text-inverse">
  <div
    class="mx-auto flex w-full max-w-8xl flex-col px-6 pt-16 pb-10 tablet:px-8 tablet:pt-20 tablet:pb-12 desktop:px-12 desktop:pt-24 desktop:pb-14"
  >
    {/* Top row: info + nav */}
    <div
      class="flex flex-col justify-between gap-12 tablet:flex-row tablet:items-start"
    >
      {/* Left — brand block */}
      <div class="max-w-xs">
        <Logo
          class="h-10 w-auto text-primary"
          role="img"
          aria-label="Zil Design"
        />
        <p class="mt-5 text-p-sm text-text-inverse/70">
          Hablemos, contáctanos mediante nuestro formulario de contacto o
          info@zil.global
        </p>
      </div>

      {/* Right — nav links */}
      <nav aria-label="Footer" class="flex flex-col gap-3">
        {
          NAV_LINKS.map((link) => (
            <a
              href={`${prefix}${link.href}`}
              class="text-p-sm text-text-inverse/70 transition-colors duration-200 hover:text-text-inverse"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    {/* Bottom row: legal + scroll-to-top */}
    <div
      class="mt-14 flex flex-col items-start justify-between gap-6 border-t border-text-inverse/15 pt-8 tablet:flex-row tablet:items-center"
    >
      <div class="text-p-sm text-text-inverse/50">
        <p>2026 Zil Design LLC. Todos los derechos reservados.</p>
        <p>El logo y otras marcas de Zil son marcas registradas</p>
        <a
          href="#"
          class="mt-2 inline-block text-text-inverse/70 transition-colors duration-200 hover:text-text-inverse"
        >
          Política de Privacidad y Cookies
        </a>
      </div>

      <Button
        href={isHome ? "#hero" : "#"}
        variant="outline"
        arrowDirection="up"
        class="shrink-0">Ir Arriba</Button
      >
    </div>
  </div>
</footer>
